---
import Footer from "../features/index/Footer.astro";
import '../styles/global.css'
import Header from "../features/index/Header.astro";
---
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
            integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
</head>

<!-- SE AÑADIÓ EL FONDO AQUÍ: bg-[url(...)] con propiedades de cobertura fija y suavizado -->
<body class="bg-[url('https://www.senave.gov.py/mecip/Imagenes/bg-mecip.png')] bg-cover bg-center bg-no-repeat bg-fixed min-h-screen flex flex-col">

<header class="bg-white/95 backdrop-blur-sm border-b-4 border-verde shadow-sm">
    <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">

        <!-- Logo SENAVE -->
        <a href="/">
            <img
                    src="https://precdn.mitic.gov.py/cms/375/logo_web.png"
                    alt="SENAVE"
                    class="h-16 w-auto object-contain"
            />
        </a>

        <!-- Título MECIP -->
        <div class="text-right">
            <p class="text-3xl font-bold text-verde tracking-wide">MECIP</p>
            <p class="text-sm text-gray-500 max-w-xs leading-snug">
                Modelo Estándar de Control Interno para Instituciones Públicas del Paraguay
            </p>
        </div>

    </div>
</header>

<!-- ════════════════════════════════════════
     NAVEGACIÓN
════════════════════════════════════════ -->
<nav class="bg-slate-900 text-slate-100 shadow-md relative z-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-14">

            <!-- Logo o Nombre de la Institución -->
            <div class="flex-shrink-0 font-bold text-lg tracking-wider text-white">
                <a href="/mecip" class="hover:text-red-400 transition-colors">MECIP</a>
            </div>

            <!-- Menú desktop -->
            <ul class="hidden sm:flex items-center gap-1 text-sm font-medium">
                {[
                    { href: '/mecip',                                           label: 'Inicio' },
                    { href: '/mecip/socializacion',                             label: 'Implementación NRM MECIP:2015' },
                    { href: 'https://www.senave.gov.py/mecip/procedimientos.php?page=1', label: 'Documentos' },
                    { href: '/mecip/calificaciones',                                  label: 'Calificaciones' },
                    { href: '#',                                                     label: 'Contacto' },
                ].map(({ href, label }) => (
                        <li>
                            <a
                                    href={href}
                                    class="block px-3 py-2 rounded-md hover:bg-slate-800 hover:text-white transition-all duration-200"
                            >
                                {label}
                            </a>
                        </li>
                ))}
            </ul>

            <!-- Menú móvil (Contenedor Alpine.js) -->
            <div class="sm:hidden flex items-center" x-data="{ open: false }">
                <button
                        @click="open = !open"
                        class="inline-flex items-center justify-center p-2 rounded-md text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-red-500 transition-colors"
                        aria-label="Abrir menú"
                >
                    <span class="sr-only">Menu</span>
                    <svg x-show="!open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg x-show="open" x-cloak class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <!-- Desplegable móvil -->
                <div
                        x-show="open"
                        x-cloak
                        @click.away="open = false"
                        class="absolute top-14 left-0 w-full bg-slate-900 border-t border-slate-800 z-50 shadow-xl"
                >
                    <ul class="px-2 pt-2 pb-4 space-y-1 text-sm font-medium">
                        {[
                            { href: '/index.html',     label: 'Inicio' },
                            { href: '/socializacion.php', label: 'Implementación NRM MECIP:2015' },
                            { href: 'https://www.senave.gov.py/mecip/procedimientos.php?page=1', label: 'Documentos' },
                            { href: '/calificaciones.html', label: 'Calificaciones' },
                            { href: '#',              label: 'Contacto' },
                        ].map(({ href, label }) => (
                                <li>
                                    <a
                                            href={href}
                                            class="block px-4 py-2.5 rounded-md hover:bg-slate-800 hover:text-white transition-colors"
                                    >
                                        {label}
                                    </a>
                                </li>
                        ))}
                    </ul>
                </div>
            </div>

        </div>
    </div>
</nav>

<!-- ════════════════════════════════════════
     BANNER
════════════════════════════════════════ -->
<div class="w-full overflow-hidden max-h-52 sm:max-h-72 shadow-inner">
    <img
            src="https://www.senave.gov.py/mecip/Imagenes/banner.jpg"
            alt="Banner SENAVE"
            class="w-full h-full object-cover object-center"
    />
</div>

<!-- ════════════════════════════════════════
     CONTENIDO PRINCIPAL (Se renderiza sobre el fondo del body)
════════════════════════════════════════ -->
<main class="flex-1 w-full relative z-10">
    <slot />
</main>

<Footer />
</body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
    }
    /* Evitamos forzar el height al 100% en el body para que el fondo scrollee de forma natural si el contenido crece */
    body {
        min-height: 100vh;
    }
</style>
