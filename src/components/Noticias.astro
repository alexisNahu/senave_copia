---
const noticias = [
    {
        titulo: "Día Internacional de la Sanidad Vegetal",
        categoria: "Noticias y Blog",
        fecha: "12 MAY",
        imagen: "https://www.senave.gov.py/wp-content/uploads/2026/05/WhatsApp-Image-2026-05-12-at-08.00.45.jpeg",
    },
    {
        titulo: "Alerta ante presión de ingreso de plagas que afectan a la soja",
        categoria: "Noticias y Blog",
        fecha: "07 MAY",
        imagen: "https://www.senave.gov.py/wp-content/uploads/2026/05/WhatsApp-Image-2026-05-12-at-08.00.45.jpeg",
    },
    {
        titulo: "Se reúne en Asunción la Comisión de Semillas del MERCOSUR",
        categoria: "Noticias y Blog",
        fecha: "06 MAY",
        imagen: "https://www.senave.gov.py/wp-content/uploads/2026/05/WhatsApp-Image-2026-05-12-at-08.00.45.jpeg",
    }
];
---

<section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">

        <div class="text-center mb-12">
            <div class="flex items-center justify-center space-x-2 text-[#22c55e] font-bold text-sm uppercase tracking-widest mb-2">
                <span class="h-[1px] w-8 bg-[#22c55e]"></span>
                <span>Actualidad</span>
                <span class="h-[1px] w-8 bg-[#22c55e]"></span>
            </div>
            <h2 class="text-4xl font-extrabold text-[#374151]">Noticias</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {noticias.map((post) => (
                    <div class="flex flex-col bg-white border border-gray-100 rounded-lg shadow-sm hover:shadow-md transition-shadow cursor-pointer overflow-visible group">

                        <div class="p-6 pb-8 flex-grow relative">
                            <div class="flex items-center text-[#22c55e] text-xs font-bold mb-3">
                                <i class="far fa-folder-open mr-2"></i>
                                {post.categoria}
                            </div>
                            <h3 class="text-xl font-bold text-[#374151] leading-tight group-hover:text-[#22c55e] transition-colors pr-10">
                                {post.titulo}
                            </h3>

                            <div class="absolute -bottom-7 right-6 z-20 w-[66px] h-[66px] bg-[#22c55e] text-white rounded-full flex flex-col items-center justify-center text-[10px] font-bold leading-none shadow-lg border-2 border-white">
                                <span class="text-[18px]">{post.fecha.split(' ')[0]}</span>
                                <span class="text-[12px] mt-1">{post.fecha.split(' ')[1]}</span>
                            </div>
                        </div>

                        <div class="relative h-64 overflow-hidden rounded-b-lg">
                            <img
                                    src={post.imagen}
                                    alt={post.titulo}
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                            />
                        </div>

                    </div>
            ))}
        </div>
    </div>
</section>
