---
interface Props {
    title: string;
    id?: string;
}

const {title, id} = Astro.props
---

<section id={id || title} class="scroll-mt-6 space-y-6 bg-white p-6 rounded-2xl border border-gray-100 shadow-xs transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
    <h2 class="text-xl font-bold text-[#00A240] pb-2 border-b-2 border-gray-100 flex items-center gap-2 group">
        <span class="w-1.5 h-5 bg-[#00A240] rounded-full inline-block transform transition-transform group-hover:scale-y-120"></span>
        {title}
    </h2>
    <slot />
</section>
