---
// FaqDenuncias.astro
const faqs = [
    { pregunta: "¿Qué es el SENAVE?", href: "#" },
    { pregunta: "¿Cómo puedo certificar mi producción frutihortícola?", href: "#" },
    { pregunta: "¿Qué son las Acreditaciones Fitosanitarias de Importación?", href: "#" },
    { pregunta: "¿Qué necesito para exportar productos vegetales?", href: "#" },
];
---

<section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">

            <div>
                <h2 class="text-[#22c55e] font-bold text-2xl underline decoration-2 underline-offset-8 mb-8">
                    Preguntas Frecuentes
                </h2>

                <div class="space-y-4">
                    {faqs.map((faq) => (
                            <a
                                    href={faq.href}
                                    class="flex items-center justify-between p-5 bg-slate-50 border border-slate-100 rounded-lg group hover:bg-white hover:shadow-md transition-all"
                            >
              <span class="text-[#4b5563] font-bold text-lg group-hover:text-[#22c55e] transition-colors pr-4">
                {faq.pregunta}
              </span>
                                <div class="flex-shrink-0 w-10 h-10 bg-white rounded-md border border-slate-200 flex items-center justify-center shadow-sm group-hover:border-[#22c55e]">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-[#22c55e]">
                                        <path fill-rule="evenodd" d="M4.5 5.653c0-1.426 1.529-2.33 2.779-1.643l11.54 6.348c1.295.712 1.295 2.573 0 3.285L7.28 19.991c-1.25.687-2.779-.217-2.779-1.643V5.653z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                            </a>
                    ))}
                </div>
            </div>

            <div class="h-full flex items-center">
                <div class="w-full bg-[#166534] rounded-lg p-12 flex flex-col items-center justify-center text-center min-h-[400px] shadow-inner relative overflow-hidden">
                    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white via-transparent to-transparent"></div>

                    <button class="relative z-10 bg-[#22c55e] hover:bg-green-400 text-white font-bold py-4 px-10 rounded-full flex items-center space-x-3 transition-all transform hover:scale-105 shadow-xl uppercase tracking-widest text-sm">
                        <span>Denuncias y Quejas</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </button>
                </div>
            </div>

        </div>
    </div>
</section>
