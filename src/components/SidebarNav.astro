---
interface Props {
    navItems: { href: string; label: string }[];
}

const { navItems } = Astro.props;
---

<aside
        class="w-full lg:w-72 shrink-0 self-start lg:sticky lg:top-[120px] z-10 transition-all duration-300"
>    <div class="bg-white lg:rounded-2xl shadow-md lg:shadow-lg border-b lg:border border-gray-200 lg:border-green-100 overflow-hidden flex flex-col w-full">
        {/* Header con efecto: En móvil actúa como BOTÓN para abrir/cerrar */}
        <button
                id="sidebar-toggle-btn"
                class="w-full bg-[#00A240] px-5 py-4 flex items-center justify-between sticky top-0 z-10 text-left lg:pointer-events-none focus:outline-none"
        >
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
                <p class="text-white font-semibold text-sm uppercase tracking-wider">Contenido</p>
            </div>

            {/* Flecha indicadora que gira */}
            <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-white transition-transform duration-300 lg:hidden"
                    id="sidebar-arrow-icon"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
            >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>

        {/* Lista de navegación modificada:
          - En móvil: h-[calc(100vh-170px)] fuerza a que ocupe todo el resto del alto de la pantalla del celular.
        */}
        <ul
                id="sidebar-links-list"
                class="hidden lg:block divide-y divide-gray-100 h-[calc(100vh-170px)] lg:h-auto overflow-y-auto w-full bg-white px-2 lg:px-0 pb-10 lg:pb-0"
        >
            {navItems.map((item, index) => (
                    <li>
                        <a
                                href={item.href}
                                class="flex items-center gap-3 px-5 py-4 text-base lg:text-sm text-gray-700 hover:bg-green-50 hover:text-[#00A240] transition-all duration-200 group border-l-2 border-l-transparent hover:border-l-[#00A240]"
                        >
                            {/* Ícono de flecha/chevrón original */}
                            <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-4 w-4 lg:h-3.5 lg:w-3.5 text-[#00A240] shrink-0 transition-all duration-200 group-hover:translate-x-0.5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                            >
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                            </svg>
                            <span class="flex-1 text-left font-medium lg:font-normal">{item.label}</span>

                            {/* Indicador de posición original */}
                            <span class="text-xs text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                                {String(index + 1).padStart(2, '0')}
                            </span>
                        </a>
                    </li>
            ))}
        </ul>
    </div>
</aside>

<style>
    /* Scrollbar personalizada para cuando los elementos excedan la pantalla */
    #sidebar-links-list::-webkit-scrollbar {
        width: 4px;
    }

    #sidebar-links-list::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    #sidebar-links-list::-webkit-scrollbar-thumb {
        background: #00A240;
        border-radius: 4px;
    }

    #sidebar-links-list::-webkit-scrollbar-thumb:hover {
        background: #008a35;
    }
</style>

<script>
    function initSidebarDropdown() {
        const toggleBtn = document.getElementById('sidebar-toggle-btn');
        const linksList = document.getElementById('sidebar-links-list');
        const arrowIcon = document.getElementById('sidebar-arrow-icon');

        if (!toggleBtn || !linksList) return;

        toggleBtn.onclick = null;

        toggleBtn.onclick = function(e) {
            if (window.innerWidth >= 1024) return;

            e.preventDefault();

            const isHidden = linksList.classList.contains('hidden');
            if (isHidden) {
                linksList.classList.remove('hidden');
                if (arrowIcon) arrowIcon.style.transform = 'rotate(180deg)';
                // Bloqueamos el scroll del sitio general para que el usuario navegue en el menú completo
                document.body.style.overflow = 'hidden';
            } else {
                linksList.classList.add('hidden');
                if (arrowIcon) arrowIcon.style.transform = 'rotate(0deg)';
                // Devolvemos el scroll normal
                document.body.style.overflow = '';
            }
        };

        window.addEventListener('resize', () => {
            if (window.innerWidth >= 1024) {
                linksList.classList.remove('hidden');
                document.body.style.overflow = '';
            } else {
                linksList.classList.add('hidden');
                if (arrowIcon) arrowIcon.style.transform = 'rotate(0deg)';
            }
        });

        // Al dar clic en un enlace, cerramos el menú y liberamos el scroll de la web
        const links = linksList.querySelectorAll('a');
        links.forEach(link => {
            link.onclick = () => {
                if (window.innerWidth < 1024) {
                    linksList.classList.add('hidden');
                    if (arrowIcon) arrowIcon.style.transform = 'rotate(0deg)';
                    document.body.style.overflow = '';
                }
            };
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSidebarDropdown);
    } else {
        initSidebarDropdown();
    }
    document.addEventListener('astro:page-load', initSidebarDropdown);
</script>
