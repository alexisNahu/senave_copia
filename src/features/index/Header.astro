            <div class="flex items-center space-x-4 mt-4 md:mt-0 nav-buttons-container transition-all duration-300">
                <button class="w-10 h-10 border-2 border-white rounded-full flex items-center justify-center hover:bg-white hover:text-[#ee2d24] transition-colors btn-search-nav">
                    <i class="fas fa-search text-sm"></i>
                </button>
                <button class="bg-[#006400] hover:bg-green-900 text-white font-bold py-4 px-6 rounded-md uppercase text-sm tracking-wider flex items-center shadow-lg btn-cta-nav transition-all duration-300">
                    ¿Qué estás buscando?
