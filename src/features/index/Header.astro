<style>
    /* Transición general */
    #main-header, #main-nav, #logo-img, .nav-links-container, .btn-cta-nav {
        transition: all 0.3s ease-in-out;
    }

    /* Estados compactos al hacer scroll */
    #main-header.scrolled {
        padding-top: 0.15rem !important;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    }

    #main-header.scrolled #logo-img {
        max-width: 230px;
    }

    #main-header.scrolled .accessibility-wrapper,
    #main-header.scrolled .flags-wrapper {
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        margin: 0 !important;
    }

    #main-header.scrolled #right-content {
        margin-top: 0 !important;
    }

    #main-header.scrolled .search-form label {
        display: none;
    }

    #main-header.scrolled .search-form input,
    #main-header.scrolled .search-form button {
        padding-top: 0.15rem;
        padding-bottom: 0.15rem;
        font-size: 0.75rem;
    }

    #main-header.scrolled #main-nav .nav-desktop {
        padding-top: 0.15rem !important;
        padding-bottom: 0.15rem !important;
    }

    #main-header.scrolled .nav-links-container a,
    #main-header.scrolled .nav-links-container button {
        font-size: 14px;
    }

    #main-header.scrolled .btn-cta-nav {
        padding-top: 0.4rem !important;
        padding-bottom: 0.4rem !important;
        font-size: 11px;
        padding-left: 1rem;
        padding-right: 1rem;
    }

    #main-header.scrolled .btn-search-nav {
        width: 2rem;
        height: 2rem;
    }

    /* Clase activa para permitir interacciones con el menú móvil */
    #mobile-menu:not(.translate-x-full) {
        pointer-events: auto !important;
    }

    /* Overlay para el menú móvil */
    .mobile-menu-open {
        overflow: hidden;
    }

    /* Rotación del icono */
    .rotate-180 {
        transform: rotate(180deg);
    }
</style>

<script>
    function initHeaderScroll() {
        const header = document.getElementById('main-header');
        if (!header) return;

        function handleScroll() {
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop || window.scrollY;
            if (scrollTop > 60) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        }

        window.removeEventListener('scroll', handleScroll);
        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll();
    }

    function closeMobileMenu(mobileMenu) {
        if (!mobileMenu) return;
        mobileMenu.classList.add('translate-x-full');
        document.body.classList.remove('mobile-menu-open');
    }

    function openMobileMenu(mobileMenu) {
        if (!mobileMenu) return;
        mobileMenu.classList.remove('translate-x-full');
        document.body.classList.add('mobile-menu-open');
    }

    function initMobileMenu() {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const closeBtn = document.getElementById('close-menu');
        const mobileMenu = document.getElementById('mobile-menu');

        if (!mobileMenu) return;

        const dropdownBtns = document.querySelectorAll('.mobile-dropdown-btn');
        const mobileSearchBtn = document.querySelector('.mobile-search-btn');
        const mobileCtaBtn = document.querySelector('.mobile-cta-btn');

        // Abrir menú móvil
        if (toggleBtn) {
            toggleBtn.onclick = function(e) {
                e.preventDefault();
                openMobileMenu(mobileMenu);
            };
        }

        // Cerrar menú con botón X
        if (closeBtn) {
            closeBtn.onclick = function(e) {
                e.preventDefault();
                closeMobileMenu(mobileMenu);
            };
        }

        // Manejar clics directos en los botones desplegables del menú móvil
        dropdownBtns.forEach(btn => {
            btn.onclick = function(e) {
                e.preventDefault();
                e.stopPropagation();

                const submenu = this.nextElementSibling;
                const icon = this.querySelector('.dropdown-icon');

                if (submenu) {
                    // Cambiamos el estado usando clases de Tailwind de forma segura
                    if (submenu.classList.contains('hidden')) {
                        submenu.classList.remove('hidden');
                    } else {
                        submenu.classList.add('hidden');
                    }
                }
                if (icon) {
                    icon.classList.toggle('rotate-180');
                }
            };
        });

        // Manejar botón de búsqueda móvil
        if (mobileSearchBtn) {
            mobileSearchBtn.onclick = function(e) {
                e.preventDefault();
                closeMobileMenu(mobileMenu);
                setTimeout(() => {
                    const searchInput = document.getElementById('search');
                    if (searchInput) {
                        searchInput.focus();
                    }
                }, 300);
            };
        }

        // Cerrar menú al presionar Escape
        document.onkeydown = function(e) {
            if (e.key === 'Escape') {
                closeMobileMenu(mobileMenu);
            }
        };
    }

    // Asegurar ejecución en ciclos Astro / SPA tradicionales
    function masterInit() {
        initHeaderScroll();
        initMobileMenu();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', masterInit);
    } else {
        masterInit();
    }

    document.addEventListener('astro:page-load', masterInit);
    document.addEventListener('popstate', masterInit);
</script>
