            </div>

        </div>
    </nav>
</header>

<!-- COLCHÓN DE ESPACIO INICIAL (Evita que el header tape tu contenido al cargar la página) -->
<div class="h-[280px] lg:h-[240px]"></div>

<style>
    /* Transición general para suavizar los cambios de tamaño */
    #main-header, #main-nav, #logo-img, .nav-links-container, .btn-cta-nav {
        transition: all 0.3s ease-in-out;
    }

    /* ==========================================
       ESTADOS COMPACTOS AL HACER SCROLL (.scrolled)
       ========================================== */

    /* 1. Reducción drástica de paddings en la zona superior */
    #main-header.scrolled {
        padding-top: 0.15rem !important;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    }

    /* El logo se reduce significativamente */
    #main-header.scrolled #logo-img {
        max-width: 230px;
    }

    /* Ocultamos accesibilidad y banderas para dar espacio vertical */
    #main-header.scrolled .accessibility-wrapper,
    #main-header.scrolled .flags-wrapper {
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        margin: 0 !important;
    }

    /* Rediseño del formulario superior en modo compacto */
    #main-header.scrolled #right-content {
        margin-top: 0 !important;
    }
    #main-header.scrolled .search-form label {
        display: none; /* Quitamos el texto para ahorrar espacio */
    }
    #main-header.scrolled .search-form input,
    #main-header.scrolled .search-form button {
        padding-top: 0.15rem;
        padding-bottom: 0.15rem;
        font-size: 0.75rem;
    }

    /* 2. Compactación de la barra de Navegación (NAV) */
    #main-header.scrolled #main-nav {
        margin-top: 0.25rem !important; /* Pegamos el nav al logo */
        padding-top: 0.15rem !important;  /* Casi sin padding vertical */
        padding-bottom: 0.15rem !important;
    }

    /* Reducción de los enlaces de navegación */
    #main-header.scrolled .nav-links-container a,
    #main-header.scrolled .nav-links-container button {
        padding-top: 0.25rem !important;
        padding-bottom: 0.25rem !important;
        font-size: 14px; /* Un punto más pequeño */
    }

    /* El gran botón verde se encoge a un tamaño discreto */
    #main-header.scrolled .btn-cta-nav {
        padding-top: 0.4rem !important;
        padding-bottom: 0.4rem !important;
        font-size: 11px;
    }

    /* El botón circular de lupa del nav también se ajusta */
    #main-header.scrolled .btn-search-nav {
        width: 2rem;
        height: 2rem;
    }
</style>

<script>
    // Creamos la lógica en una función reutilizable
    function initHeaderScroll() {
        const header = document.getElementById('main-header');
        if (!header) return;

        function handleScroll() {
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop || window.scrollY;

            if (scrollTop > 60) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        }

        // Escuchar el scroll en la página actual
        window.removeEventListener('scroll', handleScroll); // Limpieza preventiva para evitar duplicados
        window.addEventListener('scroll', handleScroll, { passive: true });

        // ¡ESTA ES LA CLAVE! Evaluamos la posición inmediatamente al cambiar de página
        handleScroll();
    }

    // 1. Ejecutar en la carga inicial de la web (F5 clásico)
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeaderScroll);
    } else {
        initHeaderScroll();
    }

    // 2. Ejecutar CADA VEZ que Astro cambie de página dinámicamente
    document.addEventListener('astro:page-load', initHeaderScroll);

    // 3. Respaldo por si usas librerías como Turbo, Livewire o Barba.js
    document.addEventListener('popstate', initHeaderScroll);
</script>
