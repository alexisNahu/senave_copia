<header class="bg-white pt-6 border-b-8 border-[#ee2d24]">
    <div class="max-w-7xl mx-auto px-4 flex flex-col lg:flex-row justify-between items-center lg:items-end pb-4">

        <div class="w-full lg:w-2/3 flex justify-between items-center">
            <a href="/" class="block">
                <img src="https://precdn.mitic.gov.py/cms/375/logo_web.png"
                     alt="MITIC Logo"
                     class="h-auto max-w-full md:max-w-[640px] object-contain">
            </a>

            <button class="lg:hidden p-2 bg-gray-800 text-white rounded">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
                </svg>
            </button>
        </div>
        <div class="w-full lg:w-1/3 flex flex-col space-y-4 mt-6 lg:mt-0">

            <div class="flex space-x-3 text-[#ee2d24] text-lg justify-start">
                <i class="fab fa-accessible-icon" aria-label="Ícono de accesibilidad"></i>
                <i class="fas fa-blind" aria-label="Ícono de accesibilidad"></i>
                <i class="fas fa-low-vision" aria-label="Ícono de accesibilidad"></i>
                <i class="fas fa-closed-captioning" aria-label="Ícono de subtítulos"></i>
                <i class="fas fa-american-sign-language-interpreting" aria-label="Ícono de lenguaje a señas"></i>
                <i class="fas fa-tty" aria-label="Ícono de tty"></i>
                <i class="fas fa-deaf" aria-label="Ícono de accesibilidad"></i>
            </div>

            <form class="w-full flex flex-col items-start">
                <label class="text-sm mb-1 w-full text-start" for="search">
                    Buscar en el sitio web
                </label>
                <div class="flex w-full border border-gray-300 rounded overflow-hidden">
                    <input type="text" id="search" placeholder="Buscar" class="w-full px-3 py-2 outline-none">
                    <button type="submit" class="bg-[#00529b] px-6 text-white hover:bg-blue-900 transition-colors">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>

            <div class="flex flex-col items-end">
                <ul class="flex space-x-1 mb-2">
                    <li class="w-[22px] h-[16px] overflow-hidden border border-gray-100">
                        <a href="javascript:;" onclick="PrisnaGWT.translate('eng');" title="English"
                           class="block w-full h-full bg-cover bg-center"
                           style="background-image: url('https://flagcdn.com/us.svg');">
                        </a>
                    </li>
                    <li class="w-[22px] h-[16px] overflow-hidden border border-gray-100">
                        <a href="javascript:;" onclick="PrisnaGWT.translate('es');" title="Spanish"
                           class="block w-full h-full bg-[url('https://templatev2.mitic.gov.py/wp-content/plugins/google-website-translator/images/all.png')] bg-[-110px_0px]"></a>
                    </li>
                    <li class="w-[22px] h-[16px] overflow-hidden border border-gray-100">
                        <a href="javascript:;" onclick="PrisnaGWT.translate('gn');" title="Guaraní"
                           class="block w-full h-full bg-[url('https://templatev2.mitic.gov.py/wp-content/plugins/google-website-translator/images/all.png')] bg-[-154px_-128px]"></a>
                    </li>
                    <li class="w-[22px] h-[16px] overflow-hidden border border-gray-100">
                        <a href="javascript:;" onclick="PrisnaGWT.translate('gn');" title="Guaraní"
                           class="block w-full h-full bg-[url('https://templatev2.mitic.gov.py/wp-content/plugins/google-website-translator/images/all.png')] bg-[-66px_-176px]"></a>
                    </li>
                </ul>
            </div>

        </div>
    </div>
</header>
