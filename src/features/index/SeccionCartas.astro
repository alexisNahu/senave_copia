---
// Servicios.astro

// Estiramos todos los servicios de manera asíncrona desde el Service

const servicios = [
    {
        id: "01",
        title: "Semillas",
        slug: "semillas",
        icono_url: "https://actimedia.top/demo/senave/wp-content/uploads/2024/08/semillas.png"
    },
    {
        id: "02",
        title: "Calidad, Inocuidad y Agricultura Orgánica",
        slug: "calidad-inocuidad-y-agricultura-organica",
        icono_url: "https://actimedia.top/demo/senave/wp-content/uploads/2024/08/calidadeino.png"
    },
    {
        id: "03",
        title: "Sistema de Trazabilidad Vegetal (DTVe)",
        slug: "senave-dtv",
        icono_url: "https://www.senave.gov.py/wp-content/uploads/2025/02/trazabillidad.png"
    },
    {
        id: "04",
        title: "Agroquímicos",
        slug: "agroquimicos",
        icono_url: "https://actimedia.top/demo/senave/wp-content/uploads/2024/08/agroquimicos.png"
    },
    {
        id: "05",
        title: "Laboratorios",
        slug: "laboratorios",
        icono_url: "https://actimedia.top/demo/senave/wp-content/uploads/2024/08/labora.png"
    },
    {
        id: "06",
        title: "Bioseguridad Agrícola",
        slug: "bioseguridad-agricola",
        icono_url: "https://actimedia.top/demo/senave/wp-content/uploads/2024/10/iconos-senave-biose.png"
    },
    {
        id: "07",
        title: "Protección Vegetal",
        slug: "proteccion-vegetal",
        icono_url: "https://actimedia.top/demo/senave/wp-content/uploads/2024/09/iconos-senave-protecvege.png"
    },
    {
        id: "08",
        title: "Operaciones",
        slug: "direccion-de-operaciones",
        icono_url: "https://actimedia.top/demo/senave/wp-content/uploads/2024/09/iconos-senave-operaciones.png"
    },
    {
        id: "09",
        title: "Geo-Estadísticas",
        slug: "geoestadisticas",
        icono_url: "https://actimedia.top/demo/senave/wp-content/uploads/2024/09/iconos-senave-geo.png"
    },
    {
        id: "10",
        title: "Capacitaciones",
        slug: "capacitaciones",
        icono_url: "https://actimedia.top/demo/senave/wp-content/uploads/2024/09/capacitaciones.png"
    },
    {
        id: "11",
        title: "Normativas",
        slug: "normativas",
        icono_url: "https://actimedia.top/demo/senave/wp-content/uploads/2024/08/normativas.png"
    },
    {
        id: "12",
        title: "Unidad de Registros",
        slug: "unidad-de-registros",
        icono_url: "https://actimedia.top/demo/senave/wp-content/uploads/2024/09/registro.png"
    }
];
---

<section class="bg-[#f8f9fa] py-16 px-4">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                servicios.map((item) => (
                        <div class="relative bg-white rounded-xl shadow-sm border border-gray-100 p-8 h-64 flex flex-col justify-between group cursor-pointer overflow-hidden transition-all duration-300 hover:shadow-xl">

                            <div class="flex justify-between items-start">
                                <div class="w-20 h-20 transition-transform duration-500 group-hover:scale-110">
                                    <img
                                            src={item.icono_url}
                                            alt={item.title}
                                            class="w-full h-full object-contain object-left-top"
                                    />
                                </div>

                                <span class="text-7xl font-bold text-[#f1f3f7] leading-none select-none">
                                {item.id}
                            </span>
                            </div>

                            <div class="z-10">
                                <h3 class="text-[#2c3e50] font-bold text-[20px] leading-tight max-w-[90%] transition-colors group-hover:text-[#22c55e]">
                                    {item.title}
                                </h3>
                            </div>

                            <div class="absolute inset-0 bg-[#22c55e]/90 flex flex-col items-center justify-center transition-all duration-500 opacity-0 translate-y-full group-hover:opacity-100 group-hover:translate-y-0 z-20">
                                <a
                                        href={`/${item.slug}`}
                                        class="flex items-center text-white font-bold text-xl"
                                >
                                    Ingresar
                                    <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                    </svg>
                                </a>
                            </div>

                        </div>
                ))
            }
        </div>
    </div>
</section>
