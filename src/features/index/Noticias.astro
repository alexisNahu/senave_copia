---
import {noticias} from '../noticias/mock'
import Card from "../noticias/Card.astro";
---

<section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">

        <div class="text-center mb-12">
            <div class="flex items-center justify-center space-x-2 text-[#22c55e] font-bold text-sm uppercase tracking-widest mb-2">
                <span class="h-[1px] w-8 bg-[#22c55e]"></span>
                <span>Actualidad</span>
                <span class="h-[1px] w-8 bg-[#22c55e]"></span>
            </div>
            <h2 class="text-4xl font-extrabold text-[#374151]">Noticias</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {noticias.map((post) => (
                <Card item={post}/>
            ))}
        </div>
    </div>
</section>
