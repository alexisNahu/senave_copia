---
import {type Noticias} from "./models";
interface Props {
    item: Noticias
}

const {item} = Astro.props
---

<a href={`/noticias/${item.slug}`} class="group flex flex-col bg-[#f0f4f6] rounded-xl overflow-hidden hover:shadow-md transition-all duration-200">

    <div class="relative w-full aspect-[16/9] overflow-hidden bg-gray-200">
        <div class="absolute top-0 left-0 z-10 bg-[#004b23] text-white text-[12px] font-bold uppercase tracking-wider px-2.5 py-1.5 rounded-br-md flex items-center gap-1.5 shadow-sm">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h1.5A2.25 2.25 0 018.25 12v.75m13.5-3.01c0-.98-.79-1.77-1.77-1.77H15.75a1.125 1.125 0 01-.814-.344L13.22 5.381a1.125 1.125 0 00-.814-.344H5.25A2.25 2.25 0 003 7.285V18a2.25 2.25 0 002.25 2.25h13.5A2.25 2.25 0 0021 18v-8.26z" />
            </svg>
            {item.categoria || "NOTICIAS Y BLOG"}
        </div>
        <img
                src={item.imagen}
                alt={item.titulo}
                class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-300"
        />
    </div>

    <div class="p-5 flex flex-col flex-grow">
                                    <span class="text-[12px] font-bold text-[#198754] uppercase tracking-wider mb-2.5">
                                      {item.fecha}
                                    </span>
        <h3 class="text-[20px] font-bold text-[#3c5043] leading-[1.35] line-clamp-2 mb-2 group-hover:text-[#198754] transition-colors">
            {item.titulo}
        </h3>
        <p class="text-[20px] text-[#666666] line-clamp-2 leading-relaxed font-normal">
            {item.excerpt || "El Servicio Nacional de Calidad y Sanidad Vegetal y de Semillas..."}
        </p>
    </div>
</a>
