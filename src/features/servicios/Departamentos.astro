---
import { type Servicio } from "../models";
interface Props {
    servicio: Servicio;
}

const { servicio } = Astro.props;
---

<div class="w-full">
    {servicio.tipo_layout === 'descargas' && (
            <div class="max-w-7xl mx-auto">
                <div class="w-full bg-[#f0fdf4]/40 border-b border-gray-100 py-6 mb-8">
                    <div class="max-w-7xl mx-auto px-6">
                        <div class="flex flex-col space-y-3">
                            {servicio.subdepartments?.map((dept) => (
                                    <div class="flex items-start space-x-3 text-[#4b5563]">
                                        <div class="flex-shrink-0 mt-1 w-5 h-5 rounded-full flex items-center justify-center border border-gray-300 bg-[#22c55e] text-white">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="w-3 h-3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </div>
                                        <span class="text-[15px] md:text-base font-medium">{dept.name}</span>
                                    </div>
                            ))}
                        </div>
                    </div>
                </div>

                <div class="max-w-7xl mx-auto px-6 space-y-16">
                    {servicio.subdepartments?.map((dept) => (
                            <div class="border-b border-gray-100 pb-12 last:border-b-0 animate-slide-up">
                                <h2 class="text-2xl md:text-3xl font-extrabold text-[#374151] mb-8">
                                    {dept.name}
                                </h2>

                                {dept.main_links && (
                                        <div class="space-y-3 mb-8 text-[15px]">
                                            {dept.main_links.map((link) => (
                                                    <a href={link.url} class="flex items-center space-x-2 text-[#22c55e] font-bold hover:underline group w-full">
                                                        <span>📄</span>
                                                        <span>{link.title}</span>
                                                    </a>
                                            ))}
                                        </div>
                                )}

                                <div class="space-y-10">
                                    {dept.sections?.map((seccion) => (
                                            <div class="space-y-3">
                                                <h3 class="text-xs font-black text-gray-400 tracking-wider uppercase pl-1">
                                                    {seccion.subtitulo}
                                                </h3>
                                                <div class="border border-gray-100 rounded-xl overflow-hidden bg-white shadow-sm divide-y divide-gray-100">
                                                    {seccion.docs.map((doc) => (
                                                            <a href={doc.url || "#"} class="flex items-center justify-between p-4 w-full hover:bg-green-50/30 transition-colors group text-[15px]">
                                                                <div class="flex items-center space-x-3 flex-grow">
                                                                    <span class="text-gray-400 group-hover:text-[#22c55e]">📄</span>
                                                                    <span class="text-gray-700 font-medium group-hover:text-[#22c55e] leading-snug">
                                                        {doc.code && <strong class="text-gray-900 group-hover:text-[#22c55e]">{doc.code} - </strong>}
                                                                        {doc.name}
                                                    </span>
                                                                </div>
                                                                <span class="text-gray-300 group-hover:text-[#22c55e] transition-transform group-hover:translate-x-1 pl-4">→</span>
                                                            </a>
                                                    ))}
                                                </div>
                                            </div>
                                    ))}
                                </div>
                            </div>
                    ))}
                </div>
            </div>
    )}

    {servicio.tipo_layout === 'informativa' && (
            <div class="max-w-7xl mx-auto px-6 py-12 animate-slide-up">

                {servicio.subdepartments && servicio.subdepartments.length > 0 && (
                        <div class="mb-12 space-y-3">
                            {servicio.subdepartments.map((dept) => (
                                    <div class="flex items-center space-x-3 text-[#4b5563]">
                                        <div class="flex-shrink-0 text-[#22c55e]">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                            </svg>
                                        </div>
                                        <span class="text-[15px] md:text-base font-medium text-gray-700">{dept.name}</span>
                                    </div>
                            ))}
                        </div>
                )}

                <div class="space-y-10">
                    {servicio.informacion_general?.map((bloque) => (
                            <div class="bg-white border border-gray-100 rounded-2xl p-6 md:p-8 shadow-sm space-y-4">
                                {bloque.titulo_bloque && (
                                        <h2 class="text-xl md:text-2xl font-bold text-gray-800 border-b border-gray-100 pb-3">
                                            {bloque.titulo_bloque}
                                        </h2>
                                )}
                                <div class="space-y-4">
                                    {bloque.parrafos.map((parrafo) => (
                                            <p class="text-gray-600 leading-relaxed text-[15px] md:text-base">
                                                {parrafo}
                                            </p>
                                    ))}
                                </div>
                                {bloque.enlaces_utiles && (
                                        <div class="mt-6 pt-4 border-t border-gray-100 space-y-3">
                                            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Enlaces y Trámites</p>
                                            {bloque.enlaces_utiles.map((link) => (
                                                    <a href={link.url} class="flex items-center space-x-3 text-[#22c55e] font-bold hover:underline w-full">
                                                        <span>🔗</span>
                                                        <span>{link.texto}</span>
                                                    </a>
                                            ))}
                                        </div>
                                )}
                            </div>
                    ))}
                </div>
            </div>
    )}
</div>
