---
interface Props {
    title: string
}

const {title} = Astro.props
---
<div class="relative h-48 md:h-80 w-full flex items-center justify-center text-center overflow-hidden border-b-[20px] border-[#A0DFA8] bg-[#c7f1d3]">
    <img
            src="https://www.senave.gov.py/wp-content/uploads/2024/08/bg-title-1.jpg"
            alt="SENAVE Header BG"
            class="absolute inset-0 w-full h-full object-cover object-center select-none pointer-events-none mix-blend-normal"
    />

    <div class="absolute inset-0 bg-[#C7F1D3]/10 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 relative z-10 w-full">
        <h1 class="text-4xl md:text-5xl font-extrabold text-[#374151] tracking-tight animate-fade-in font-sans">
            {title}
        </h1>
    </div>
</div>
