---

import {type Servicio} from "../models";
import Departamentos from "./Departamentos.astro";

interface Props {
    servicio: Servicio
}

const {servicio} = Astro.props

---

{servicio.image_url && (
<div class="max-w-7xl mx-auto px-4 md:px-6 my-8">
    <img
            src={servicio.image_url}
            alt={`Banner de ${servicio.title}`}
            class="w-full h-auto rounded-2xl shadow-md object-cover"
    />

    {servicio.texto_banner && (
            <div class="mt-4 p-4 md:px-6 text-gray-600 text-sm md:text-base leading-relaxed bg-slate-50/50 rounded-xl border border-slate-100">
                <p>{servicio.texto_banner}</p>
            </div>
    )}
    <Departamentos servicio={servicio} />

</div>
    )}
