---
interface Props {
    initialSearch?: string;
    initialPerPage?: number;
    initialAdministration?: string;
}

const {
    initialSearch = '',
    initialPerPage = 10,
    initialAdministration = ''
} = Astro.props;

// Mock de administraciones (puedes reemplazarlo por datos de tu API getAdministrations si los tienes)
const administrations = [
    { id: "luis-samaniego", name: "Ing. Agr. Luis Ramiro Samaniego Montiel" },
    { id: "pastor-soria", name: "Ing. Agr. Pastor Soria" },
];
---

<div class="w-full max-w-6xl mx-auto px-4 md:px-6 mt-8 mb-6">
    <form method="GET" action={Astro.url.pathname} class="space-y-6">

        <div class="flex flex-col gap-2">
            <label for="administration" class="text-xs md:text-sm font-medium text-gray-600">
                Administración
            </label>
            <div class="relative max-w-2xl">
                <select
                        id="administration"
                        name="administration"
                        class="w-full bg-white border border-gray-300 rounded-md py-2.5 pl-3 pr-10 text-xs md:text-sm text-gray-700 focus:outline-none focus:border-[#00A240] focus:ring-1 focus:ring-[#00A240] appearance-none cursor-pointer"
                        onchange="this.form.submit()"
                >
                    <option value="">Todas las administraciones</option>
                    {administrations.map((admin) => (
                            <option value={admin.id} selected={admin.id === initialAdministration}>
                                {admin.name}
                            </option>
                    ))}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-500">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-2">

            <div class="flex items-center gap-2 text-xs md:text-sm text-gray-600">
                <span>Mostrar</span>
                <select
                        name="per_page"
                        class="bg-white border border-gray-300 rounded md:px-2 py-1 text-center font-medium focus:outline-none focus:border-[#00A240] cursor-pointer"
                        onchange="this.form.submit()"
                >
                    {[10, 15, 25, 50].map((size) => (
                            <option value={size} selected={size === Number(initialPerPage)}>
                                {size}
                            </option>
                    ))}
                </select>
                <span>Entradas</span>
            </div>

            <div class="flex items-center gap-2 text-xs md:text-sm text-gray-600 w-full sm:w-auto">
                <label for="search" class="shrink-0">Buscar:</label>
                <div class="relative w-full sm:w-64">
                    <input
                            id="search"
                            type="text"
                            name="search"
                            value={initialSearch}
                            placeholder="N° o palabra clave..."
                            class="w-full bg-white border border-gray-300 rounded px-3 py-1.5 text-gray-700 focus:outline-none focus:border-[#00A240] focus:ring-1 focus:ring-[#00A240]"
                    />
                    {initialSearch && (
                            <a
                                    href={Astro.url.pathname}
                                    class="absolute inset-y-0 right-0 flex items-center pr-2.5 text-gray-400 hover:text-gray-600 text-xs font-bold"
                                    title="Limpiar búsqueda"
                            >
                                ✕
                            </a>
                    )}
                </div>
            </div>

        </div>
    </form>
</div>
