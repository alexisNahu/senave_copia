---
import Layout from '../layouts/Layout.astro';
import Header from '../features/servicios/Header.astro';
import { ResolutionsService } from "../features/resoluciones/services";
import ResolucionesPage from "../features/resoluciones/senave/react/ResolucionesPage";
import SidebarNav from '../components/SidebarNav.astro';

const response = await ResolutionsService.search({ section: 'resolutions-senave', page: 1, per_page: 10 });
const resoluciones = response?.data || [];
const meta = response?.meta || { current_page: 1, last_page: 1, per_page: 10 };
const currentPath = Astro.url.pathname;

---

<Layout>
    <Header title="Resoluciones" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Contenido principal - Ocupa todo el ancho en móvil -->
            <main class="flex-1 min-w-0 bg-white rounded-xl shadow-sm overflow-hidden">
                <ResolucionesPage
                        client:load
                        initialResoluciones={resoluciones}
                        initialMeta={meta}
                        currentPath={currentPath}
                />
            </main>

        </div>
    </div>
</Layout>

<style>
    main {
        font-variant-ligatures: common-ligatures;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    /* Asegurar que el contenido no se desborde en móvil */
    .min-w-0 {
        min-width: 0;
    }

    /* Forzar que el contenido del ResolucionesPage sea responsivo */
    :global(.resoluciones-container) {
        overflow-x: auto;
        max-width: 100%;
    }

    /* Mejorar la visualización de tablas en móvil */
    :global(table) {
        display: block;
        overflow-x: auto;
        width: 100%;
        -webkit-overflow-scrolling: touch;
    }

    /* Ajustes para el título del header */
    :global(.page-header) {
        word-break: break-word;
        white-space: normal !important;
        overflow-wrap: break-word;
    }

    :global(h1), :global(.title_page span) {
        word-break: break-word;
        white-space: normal !important;
        overflow-wrap: break-word;
        max-width: 100%;
        display: block;
    }

    /* Mejoras para móvil */
    @media (max-width: 768px) {
        :global(.resoluciones-container) {
            padding: 0.5rem;
        }

        :global(.pagination) {
            flex-wrap: wrap;
            justify-content: center;
        }

        /* Títulos más pequeños en móvil */
        :global(h1), :global(.title_page span) {
            font-size: 1.25rem !important;
            line-height: 1.3 !important;
            padding: 0 0.5rem !important;
        }

        /* Ajustar contenedores */
        :global(.banner_title_inner), :global(.page_header_content) {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }
    }

    /* Para pantallas muy pequeñas */
    @media (max-width: 480px) {
        :global(h1), :global(.title_page span) {
            font-size: 1.1rem !important;
        }
    }
</style>
