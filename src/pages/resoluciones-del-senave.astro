---
import Layout from '../layouts/Layout.astro';
import Header from '../features/servicios/Header.astro';
import { ResolutionsService } from "../features/resoluciones/services";
import ResolucionesPage from "../features/resoluciones/react/ResolucionesPage";

// SSR inicial rápido en el servidor
const response = await ResolutionsService.get({ page: 1, per_page: 10 });
const resoluciones = response?.data || [];
const meta = response?.meta || { current_page: 1, last_page: 1, per_page: 10 };
const currentPath = Astro.url.pathname;
---

<Layout>
    <Header title="Resoluciones" />

    <main class="bg-white text-gray-800">
        {/* El componente maneja de manera autónoma el contexto tanto en SSR como en el cliente */}
        <ResolucionesPage
                client:load
                initialResoluciones={resoluciones}
                initialMeta={meta}
                currentPath={currentPath}
        />
    </main>
</Layout>

<style>
    main {
        font-variant-ligatures: common-ligatures;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
</style>
