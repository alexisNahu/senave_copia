---
import Header from "../features/servicios/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title={`LABORATORIOS - SENAVE`}>
    <main class="pb-20 bg-white">
        <Header title={'laboratorios'}/>

        <section class="max-w-7xl px-4 pt-20 pb-24 w-full mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 px-4">

                <div class="flex flex-col items-start text-left">
                    <div class="relative w-28 h-28 bg-[#f0f4f8] rounded-full flex items-center justify-center mb-6">
                        <div class="absolute bottom-2 left-2 w-0 h-0 border-l-[14px] border-l-transparent border-r-[14px] border-r-transparent border-t-[16px] border-t-[#00a650] transform -rotate-45"></div>
                    </div>
                    <h2 class="text-4xl font-extrabold text-[#004d26] mb-3 tracking-wide">DLQ</h2>
                    <p class="text-[15px] text-gray-600 font-medium leading-relaxed mb-8 min-h-[48px]">
                        Departamento de Laboratorios Químicos
                    </p>
                    <div class="flex flex-col gap-6 text-[12px] font-bold text-[#00a650] tracking-wider leading-snug">
                        <a href="/laboratorio-de-control-de-calidad-de-insumos-de-uso-agricola" class="hover:text-green-800 transition-colors flex items-center gap-2">
                            LABORATORIO DE CONTROL DE CALIDAD DE INSUMOS DE USO AGRÍCOLA <span class="text-lg font-light">→</span>
                        </a>
                        <a href="/laboratorio-de-control-de-calidad-de-insumos-de-uso-agricola" class="hover:text-green-800 transition-colors flex items-center gap-2">
                            LABORATORIO DE RESIDUOS DE PLAGUICIDAS Y MICOTOXINAS <span class="text-lg font-light">→</span>
                        </a>
                        <a href="/laboratorio-de-fertilizantes" class="hover:text-green-800 transition-colors flex items-center gap-2">
                            LABORATORIO DE FERTILIZANTES <span class="text-lg font-light">→</span>
                        </a>
                    </div>
                </div>

                <div class="flex flex-col items-start text-left">
                    <div class="relative w-28 h-28 bg-[#f0f4f8] rounded-full flex items-center justify-center mb-6">
                        <div class="absolute bottom-2 left-2 w-0 h-0 border-l-[14px] border-l-transparent border-r-[14px] border-r-transparent border-t-[16px] border-t-[#00a650] transform -rotate-45"></div>
                    </div>
                    <h2 class="text-3xl font-extrabold text-[#2d3748] mb-3 tracking-wide">DLSVBM</h2>
                    <p class="text-[15px] text-gray-600 font-medium leading-relaxed mb-8 min-h-[48px]">
                        Departamento de Sanidad Vegetal y Biología Molecular
                    </p>
                    <a href="/departamento-de-sanidad-vegetal-y-biologia-molecular" class="text-[#00a650] font-bold text-[13px] tracking-wider flex items-center gap-1 hover:text-green-800 transition-colors mt-auto">
                        VER MÁS <span class="text-lg font-light">→</span>
                    </a>
                </div>

                <div class="flex flex-col items-start text-left">
                    <div class="relative w-28 h-28 bg-[#f0f4f8] rounded-full flex items-center justify-center mb-6">
                        <div class="absolute bottom-2 left-2 w-0 h-0 border-l-[14px] border-l-transparent border-r-[14px] border-r-transparent border-t-[16px] border-t-[#00a650] transform -rotate-45"></div>
                    </div>
                    <h2 class="text-3xl font-extrabold text-[#2d3748] mb-3 tracking-wide">DLSyCV</h2>
                    <p class="text-[15px] text-gray-600 font-medium leading-relaxed mb-8 min-h-[48px]">
                        Departamento de Laboratorio de Semillas y Calidad Vegetal
                    </p>
                    <a href="/departamento-de-laboratorio-de-semillas-y-calidad-vegetal-2" class="text-[#00a650] font-bold text-[13px] tracking-wider flex items-center gap-1 hover:text-green-800 transition-colors mt-auto">
                        VER MÁS <span class="text-lg font-light">→</span>
                    </a>
                </div>

                <div class="flex flex-col items-start text-left">
                    <div class="relative w-28 h-28 bg-[#f0f4f8] rounded-full flex items-center justify-center mb-6">
                        <div class="absolute bottom-2 left-2 w-0 h-0 border-l-[14px] border-l-transparent border-r-[14px] border-r-transparent border-t-[16px] border-t-[#00a650] transform -rotate-45"></div>
                    </div>
                    <h2 class="text-3xl font-extrabold text-[#2d3748] mb-3 tracking-wide">DMLE</h2>
                    <p class="text-[15px] text-gray-600 font-medium leading-relaxed mb-8 min-h-[48px]">
                        Departamento de Muestreo Laboratorial Especializado
                    </p>
                    <a href="/departamento-de-muestreo-laboratorial-especializado" class="text-[#00a650] font-bold text-[13px] tracking-wider flex items-center gap-1 hover:text-green-800 transition-colors mt-auto">
                        VER MÁS <span class="text-lg font-light">→</span>
                    </a>
                </div>

            </div>
        </section>
    </main>
</Layout>
