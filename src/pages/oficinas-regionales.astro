<Layout>
    <Header title="Dirección de Oficinas Regionales" />

    <main class="bg-white text-gray-800">
        <div class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-16 pb-24">

            <p class="text-sm md:text-base text-gray-600 max-w-5xl mb-10 leading-relaxed">
                La Dirección de Oficinas Regionales tiene como objetivo dirigir las acciones en todo el país, a través de sus diferentes Oficinas Regionales, las mismas tienen la tarea de representar y ejercer acciones técnicas, operativas y administrativas de la institución en el ámbito geográfico regional. Se cuenta con 16 Oficinas distribuidos en los diferentes departamentos del territorio nacional, entre sus funciones se encuentran las de fiscalizar productos y sub productos vegetales, productos fitosanitarios y semillas, implementar y ejecutar programas establecidos por las áreas técnicas, entre otros.
            </p>

            <div class="w-full overflow-x-auto border border-gray-200 rounded-lg shadow-sm">
                <table class="w-full text-left border-collapse text-xs md:text-sm">
                    <thead>
                    <tr class="bg-gray-100 text-gray-700 font-bold uppercase tracking-wider border-b border-gray-200">
                        <th class="py-4 px-4 min-w-[220px]">Dependencia</th>
                        <th class="py-4 px-4 min-w-[130px]">Nro. de Contacto</th>
                        <th class="py-4 px-4 min-w-[220px]">Correo Electrónico</th>
                        <th class="py-4 px-4 min-w-[300px]">Dirección</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                    {oficinas.map((oficina) => (
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="py-4 px-4 font-semibold text-gray-700">
                                    {oficina.dependencia}
                                </td>
                                <td class="py-4 px-4 font-medium text-[#00A240] whitespace-nowrap">
                                    {oficina.contacto}
                                </td>
                                <td class="py-4 px-4 text-gray-600">
                                    <a href={`mailto:${oficina.correo}`} class="hover:text-[#00A240] hover:underline">
                                        {oficina.correo}
                                    </a>
                                </td>
                                <td class="py-4 px-4 text-gray-600 leading-normal">
                                    {oficina.direccion}
                                </td>
                            </tr>
                    ))}
                    </tbody>
                </table>
            </div>

        </div>
    </main>
</Layout>

<style>
    /* Optimizaciones tipográficas */
    main {
