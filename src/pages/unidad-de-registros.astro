---
import Layout from '../layouts/Layout.astro';
import Header from '../features/servicios/Header.astro';
import SidebarNav from '../components/SidebarNav.astro';
import Seccion from "../components/Seccion.astro";
import SeccionDeDocumentos from "../components/SeccionDeDocumentos.astro";
import PrincipalImage from "../components/PrincipalImage.astro";

// Items de navegación
const navItems = [
    { href: '#formularios', label: 'Formularios' },
    { href: '#resoluciones-referentes', label: 'Resoluciones Referentes' }
];

// ========== FORMULARIOS ==========
const formularios = [
    {
        title: "FORMULARIO – RESOLUCIÓN N° 830-2022- REGISTRO DE IMPORTADOR DE PRODUCTOS Y SUBPRODUCTOS DE ORIGEN VEGETAL – TRAMITE ELECTRONICO",
        url: "https://www.senave.gov.py/docs/unidad-registros/FORMULARIO-RESOLUCION N-830-2022-REGISTRO DE IMPORTADOR DE PRODUCTOS Y SUBPRODUCTOS DE ORIGEN VEGETAL-TRAMITE ELECTRONICO.docx"
    },
    {
        title: "FORMULARIO – VIVEROS – RESOLUCIÓN Nº 359-2023",
        url: "https://www.senave.gov.py/docs/operaciones/FORMULARIO%20-%20VIVEROS%20-%20RESOLUCION%20N-359-2023.docx"
    },
    {
        title: "FORMULARIOS – RESOLUCIÓN Nº 670-22 – SILOS – CENTROS DE ACOPIO Y PUERTYOS DE EMBARQUE",
        url: "https://www.senave.gov.py/docs/operaciones/FORMULARIOS-RESOLUCION%20N-670-22-SILOSS-CENTROS%20DE%20ACOPIO%20Y%20PUERTYOS%20DE%20EMBARQUE.docx"
    },
    {
        title: "FORMULARIO DE RESOLUCIÓN 794/14 – POR EL CUAL SE APRUEBA EL PROCEDIMIENTO PARA LA IMPORTACION DE PRODUCTOS VEGETALES POR DESPACHO MENOR (IDM) Y EL FORMULARIO DE REGISTRO DE IMPORTADOR",
        url: "https://www.senave.gov.py/docs/unidad-registros/2025 - FORMULARIO - RESOLUCION N794-14 - DESPACHO MENOR.docx"
    },
    {
        title: "SOLICITUD DE REGISTRO DE EMPRESA EXPORTADORA DE ARROZ A MEXICO",
        url: "https://www.senave.gov.py/docs/operaciones/FOR%20DE%20REG%20RES%20N%C2%BA%20146-23.docx"
    }
];

// ========== RESOLUCIONES REFERENTES ==========
const resolucionesReferentes = [
    {
        title: "RESOLUCIÓN Nº 359/2023 - POR LA CUAL SE ACTUALIZAN LOS PROCEDIMIENTOS PARA LA HABILITACION E INSPECCIÓN FITOSANITARIA DE VIVEROS FRUTALES, ORNAMENTALES, MEDICINALES, FORESTALES Y AFINES",
        url: "https://www.senave.gov.py/docs/dicao/RESOLUCION-359-UR.pdf"
    },
    {
        title: "RESOLUCIÓN Nº 146/2023 - POR LA CUAL SE CREA EL REGISTRO DE EMPRESAS EXPORTADORAS, PLANTAS DE PROCESAMIENTO O MOLINOS ARROCEROS, CON FINES DE EXPORTACIÓN DE ARROZ A MÉXICO",
        url: "https://www.senave.gov.py/docs/resoluciones/senave/Resolucion_146_Creaccion%20de%20registro%20exportadores%20de%20arroz.pdf"
    },
    {
        title: "RESOLUCIÓN N° 830/2022 - Por la cual se actualizan los requisitos y lineamientos para el registro y habilitación de personas físicas y jurídicas como importador de productos y subproductos de origen vegetal",
        url: "https://www.senave.gov.py/docs/unidad-registros/RESOLUCION N830 - 2022 - REGISTRO DE IMPORTADOR DE VEGETALES.pdf"
    },
    {
        title: "RESOLUCIÓN Nº 670 - POR LA CUAL SE ACTUALIZAN LOS REQUISITOS Y LINEAMIENTOS PARA EL REGISTRO DE SILOS, CENTROS DE ACOPIO Y PUERTOS DE EMBARQUE, DE PRODUCTOS Y SUBPRODUCTOS DE ORIGEN VEGETAL",
        url: "https://www.senave.gov.py/docs/resoluciones/senave/611c8c919bb6c62b1443b5b10a858c46.pdf"
    },
    {
        title: "RESOLUCIÓN Nº 439 - POR LA CUAL SE ACTUALIZAN LOS REQUISITOS PARA EL REGISTRO Y HABILITACIÓN DE EMPRESAS APLICADORAS DE TRATAMIENTOS CUARENTENARIOS A EMBALAJES DE MADERA (EMATREM)",
        url: "https://www.senave.gov.py/docs/resoluciones/senave/fecca37b91408f178fbe375967258968.pdf"
    },
    {
        title: "RESOLUCIÓN Nº 839/2019 - POR LA CUAL SE ACTUALIZAN LOS REQUISITOS Y LINEAMIENTOS PARA EL REGISTRO Y HABILITACIÓN DE PERSONAS FÍSICAS Y/O JURÍDICAS COMO IMPORTADOR DE PRODUCTOS Y SUBPRODUCTOS DE ORIGEN VEGETAL",
        url: "https://www.senave.gov.py/docs/resoluciones/senave/RESOLUCION-839-UR.pdf"
    },
    {
        title: "RESOLUCIÓN N° 718/19 - POR LA CUAL SE DISPONEN LOS LINEAMIENTOS PARA LA IMPORTACIÓN E INGRESO, ASÍ COMO LAS CONDICIONES PARA LA SIEMBRA Y TOMA DE MUESTRA DE LAS FLORES DEL CANNABIS SP",
        url: "https://www.senave.gov.py/docs/resoluciones/senave/RESOLUCION%20N%20718%20-2019%20-%20%20IMPORTACION%20DE%20CANNABIS%20SP%20USO%20MEDICINAL%20-%20DINAVISA.pdf"
    },
    {
        title: "RESOLUCIÓN 794/14 - POR LA CUAL SE APRUEBA EL PROCEDIMIENTO PARA LA IMPORTACIÓN DE PRODUCTOS VEGETALES POR DESPACHO MENOR (IDM) Y EL FORMULARIO DE REGISTRO DE IMPORTADOR",
        url: "https://www.senave.gov.py/docs/unidad-registros/RESOLUCION N 794-2014 DESPACHO MENOR.pdf"
    }
];
---

<Layout>
    <Header title="Unidad de Registros" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col lg:flex-row gap-10">

            <SidebarNav navItems={navItems} />

            <main class="flex-1 text-sm text-gray-700 space-y-12 leading-relaxed">

                <!-- Formularios -->
                <Seccion title="Formularios" id="formularios">
                    <SeccionDeDocumentos
                            items={formularios}
                            title=""
                            type="word"
                    />
                </Seccion>

                <!-- Resoluciones Referentes -->
                <Seccion title="Resoluciones Referentes" id="resoluciones-referentes">
                    <SeccionDeDocumentos
                            items={resolucionesReferentes}
                            title=""
                            type="pdf"
                    />
                </Seccion>

            </main>
        </div>
    </div>
</Layout>
