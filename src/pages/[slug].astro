---
import { ServiciosService } from "../features/servicios/service";
import Layout from "../layouts/Layout.astro";
import Header from "../features/servicios/Header.astro";
import Departamentos from "../features/servicios/Departamentos.astro";
import Tabla from "../features/servicios/Tabla.astro";
import BloqueInformativo from "../features/servicios/BloqueInformativo.astro";
import BannerDescriptivo from "../features/servicios/BannerDescriptivo.astro";

export async function getStaticPaths() {
    const servicios = await ServiciosService.getAll();
    return servicios.map((servicio) => ({
        params: { slug: servicio.slug },
    }));
}

const { slug } = Astro.params;

const servicio = await ServiciosService.getBySlug(slug || '');

if (!servicio) {
    return Astro.redirect('/404');
}
---

<Layout title={`${servicio.title} - SENAVE`}>
    <main class="pb-20 bg-white">
        <Header title={servicio.title}/>
        <BannerDescriptivo servicio={servicio} />

        <div class="max-w-5xl mx-auto px-4 md:px-6 space-y-12 mt-8">
            <BloqueInformativo informacion_general={servicio.informacion_general} />
            <Tabla tabla={servicio.tabla} />
        </div>
    </main>
</Layout>

<style>
    .animate-fade-in {
        animation: fadeIn 0.4s ease-out forwards;
    }
    .animate-slide-up {
        animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @keyframes slideUp {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
