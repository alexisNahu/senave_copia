                                <table class="w-full text-left text-sm border-collapse">
                                    <thead>
                                    <tr class="bg-green-600 text-white font-semibold">
                                        <th class="px-3 py-2 text-center w-16">Año</th>
                                        <th class="px-3 py-2">Resolución MAG Nº</th>
                                        <th class="px-3 py-2 text-center w-20">Especie</th>
