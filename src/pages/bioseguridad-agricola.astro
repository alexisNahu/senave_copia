---
import Layout from '../layouts/Layout.astro';
import Header from '../features/servicios/Header.astro';
import SidebarNav from '../components/SidebarNav.astro';
import Seccion from "../components/Seccion.astro";
import SeccionDeDocumentos from "../components/SeccionDeDocumentos.astro";
import PrincipalImage from "../components/PrincipalImage.astro";

// Items de navegación vinculados exactamente a las IDs de tus secciones
const navItems = [
    { href: '#direccion-bioseguridad', label: 'Dirección de Bioseguridad' },
    { href: '#deba', label: 'Evaluación de Bioseguridad Agrícola (DEBA)' },
    { href: '#dmogm', label: 'Manejo de Organismos Modificados (DMOGM)' },
];
---

<Layout>
    <Header title="Bioseguridad Agrícola" />

    <PrincipalImage src="https://www.senave.gov.py/wp-content/uploads/2024/10/bioseguridad-1024x259.jpg" alt="Bioseguridad Agrícola" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col lg:flex-row gap-10">

            <SidebarNav navItems={navItems} />

            <main class="flex-1 text-sm text-gray-700 space-y-12 leading-relaxed">

                <Seccion title="Bioseguridad Agrícola">
                    <!-- Imagen principal -->

                    <!-- Descripción principal -->
                    <p class="text-gray-700 leading-relaxed mb-8">
                        La Dirección de Bioseguridad Agrícola atiende, coordina y organiza las normativas, el seguimiento, operación y vigilancia de las actividades vinculadas a la bioseguridad de la biotecnología moderna del ámbito agrícola, entre ellas la importación y liberación comercial de productos y subproductos de organismos genéticamente modificados (OGM), apoyando la definición de la política nacional y en el fortalecimiento de las capacidades para el acceso a las informaciones relacionadas a los OGM.
                    </p>

                    <!-- Dirección de Bioseguridad -->
                    <div id="DPUV" class="scroll-mt-20">
                        <Seccion title="Dirección de Bioseguridad" id="direccion-bioseguridad">
                            <h3 class="text-gray-800 font-bold text-lg mb-4">Ley y Decretos</h3>
                            <SeccionDeDocumentos
                                    items={[
                                        { title: "Ley N°2309 \"Que aprueba el Protocolo de Cartagena sobre Seguridad de la Biotecnología del Convenio sobre la diversidad biológica\"", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Res-5.pdf" },
                                        { title: "Protocolo de Cartagena sobre Seguridad de la Biotecnología del Convenio sobre la diversidad biológica", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Res-1.pdf" },
                                        { title: "Decreto Nº 4753 \"Por el cual se designan centro focal nacional y autoridades nacionales competentes del protocolo de Cartagena\"", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Res-2.pdf" },
                                        { title: "Decreto N°9699 \"Por el cual se crea la Comisión Nacional de Bioseguridad Agropecuaria y Forestal (CONBIO)\"", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Res-4.pdf" },
                                        { title: "Decreto N° 6733 \"Por el cual se aprueba el documento sobre Política y Programa Nacional de Biotecnología Agropecuaria y Forestal del Paraguay\"", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Res-3.pdf" }
                                    ]}
                                    title=""
                                    type="pdf"
                            />

                            <h3 class="text-gray-800 font-bold text-lg mt-6 mb-4">Resoluciones</h3>
                            <SeccionDeDocumentos
                                    items={[
                                        { title: "Resolución N° 283 \"Por la cual se aprueba el procedimiento para la gestión del riesgo en actividades con organismos genéticamente modificados\"", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Res-7.pdf" },
                                        { title: "Resolución N°925 \"Por la cual se implementa el registro de empresas que operan con organismos genéticamente modificados regulados\"", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Res-8.pdf" },
                                        { title: "Resolución N°176 \"Por la cual se crea la Dirección de Bioseguridad Agrícola\"", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Res-9.pdf" },
                                        { title: "RESOLUCION N° 1348/2019 \"POR LA CUAL SE REGLAMENTA EL DECRETO N° 9.699\"", url: "#" },
                                        { title: "RESOLUCION N° 1071/2019 \"POR LA CUAL SE REGLAMENTA LA RESOLUCION MAG N° 1030/2019\"", url: "https://www.senave.gov.py/docs/bioseguridad/Resolucion-MAG-N°1071-Reglamenta-Resolucion-MAG-N°1348.pdf" }
                                    ]}
                                    title=""
                                    type="pdf"
                            />

                            <h3 class="text-gray-800 font-bold text-lg mt-6 mb-4">Lista de servicios</h3>
                            <SeccionDeDocumentos
                                    items={[
                                        { title: "RESOLUCION N° 532/2025. \"POR LA CUAL SE ACTUALIZA LOS CONCEPTOS Y LOS MONTOS A PERCIBIR POR PRESTACION DE SERVICIOS\"", url: "#" },
                                        { title: "RESOLUCION N° 565/2025. \"POR LA CUAL SE MODIFICA EL ANEXO DE LA RESOLCION N° 532/2025\"", url: "https://www.senave.gov.py/docs/bioseguridad/RESOLUCION DE TASAS 565.pdf" }
                                    ]}
                                    title=""
                                    type="pdf"
                            />

                            <h3 class="text-gray-800 font-bold text-lg mt-6 mb-4">Resoluciones CONBIO</h3>
                            <SeccionDeDocumentos
                                    items={[
                                        { title: "RESOLUCION 842/2025 \"FORMULARIO 3: DE CONSULTA PREVUIA PARA PRODUCTOS OBTENIDOS MEDIANTE NUEVAS TECNICAS DE MEJORAMIENTO\"", url: "https://www.senave.gov.py/docs/bioseguridad/Reolucion MAG N° 842 Formulario 3.pdf" },
                                        { title: "RESOLUCION 905/2025. \"POR LA CUAL SE APRUEBA LA UTILIZACION DE LA PLATAFORMA ONLINE SISTEMA DE SEGUIMIENTO DE EXPEDIENTES DE LA CONBIO\"", url: "https://www.senave.gov.py/docs/bioseguridad/RESOLUCION 905 2025-POR LA CUAL SE APRUEBA LA UTILIZACION DE LA PLATAFORMA ON LIN SMA DE SEG EXPDTS CONBIO (3).pdf" }
                                    ]}
                                    title=""
                                    type="pdf"
                            />
                        </Seccion>
                    </div>

                    <!-- Departamento de Evaluación de Bioseguridad Agrícola (DEBA) -->
                    <div id="DCS" class="scroll-mt-20">
                        <Seccion title="Departamento de Evaluación de Bioseguridad Agrícola (DEBA)" id="deba">
                            <SeccionDeDocumentos
                                    items={[
                                        { title: "Empresas Registradas en el REOGM", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/1-Empresas-registradas-en-el-REOGM.pdf" },
                                        { title: "Formularios para inscripción el REOGM", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/2-Formularios-REOGM.pdf" },
                                        { title: "Eventos Regulados en proceso de evaluación", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/3-Eventos-regulados-en-proceso-de-evaluación.pdf" },
                                        { title: "Archivo fotográfico de cadena de custodia", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/5-Archivo-Fotográfico-Cadena-de-Custodia.docx" }
                                    ]}
                                    title="Documentos"
                                    type="pdf"
                            />

                            <h3 class="text-gray-800 font-bold text-lg mt-6 mb-4" id="resoluciones-de-convio">Resoluciones CONBIO de eventos regulados</h3>
                            <SeccionDeDocumentos
                                    items={[
                                        { title: "Resolución MAG Nº 826-23 MONSANTO", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/RESOLUCIÓN-MAG-No-826-23-MONSANTO.pdf" },
                                        { title: "Resolución MAG Nº 556-23 INDEAR", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/RESOLUCIÓN-MAG-No-556-23-INDEAR.pdf" },
                                        { title: "Resolución MAG N° 1198_17_1 DOW AGROSCIENCES", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolución-MAG-N°-1198_17_1-POR-LA-CUAL-AUTORIZA-A-LA-FIRMA-DOW-AGROSCIENCES.pdf" },
                                        { title: "Resolución MAG N° 891 LC Bt11 maíz", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolucion-MAG-N°-891-LC-Bt11-maíz.pdf" },
                                        { title: "Resolución MAG N° 890 LC TC1507 maíz", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolucion-MAG-N°-890-LC-TC1507-maíz.pdf" },
                                        { title: "Resolución MAG N° 814 LC MON1445 y MON531 x MON1445 algodón", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolución-MAG-N°-814-LC-MON1445-y-MON531-x-MON1445-algodón.pdf" },
                                        { title: "Resolución MAG N° 697 Semillas Bajo Custodia", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolución-MAG-N°-697-Semillas-Bajo-Custodia.pdf" },
                                        { title: "Resolución MAG N° 669_15 LC Bt11 x MIR162 x GA21 maíz", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolución-MAG-N°-669_15-LC-Bt11-x-MIR162-x-GA21-GA21-Combinacion-de-parentales-maíz.pdf" },
                                        { title: "Resolución MAG N° 648_15 LC TC1507 x MON810 x NK603 maíz", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolución-MAG-N°-648_15-LC-TC1507-x-MON810-x-NK603-maíz.pdf" },
                                        { title: "Resolución MAG N° 447 soja MON 87701 x MON 8978", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolución-MAG-N°-447-soja-MON-87701-x-MON-8978-1.pdf" },
                                        { title: "Resolución MAG N° 252 LC MON89034 x TC1507 x NK603 maíz", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolución-MAG-N°-252-LC-MON89034-x-TC1507-x-NK603-maíz.pdf" },
                                        { title: "Resolución MAG N° 241 LC MIR 162 maíz", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolución-MAG-N°-241-LC-MIR-162-maíz.pdf" },
                                        { title: "Resolución MAG N° 153 LC MON87701 x MON89788 soja Intacta", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolucion-MAG-N°-153-LC-MON87701-x-MON89788-soja-Intacta.pdf" },
                                        { title: "Resolución MAG N° 19 LC NK 603 maíz", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolución-MAG-N°-19-LC-NK-603-maíz.pdf" },
                                        { title: "Resolución MAG N° 18 semillas bajo custodia", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolucion-MAG-N°-18-semillas-bajo-custodia.pdf" },
                                        { title: "Resolución MAG N 988", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolucion-MAG-N-988.pdf" },
                                        { title: "Resolución MAG N 27_15 Formularios 1 y 2", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolucion-MAG-N-27_15-Formularios-1-y-2.pdf" },
                                        { title: "Resolución MAG N° 334 ER Maiz", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/Resolución-MAG-N°-334-ER-Maiz-MON87427-x-MON95379-x-MON87411-x-MON87427-x-MON87419-Y-MON87427-x-NK603-x-MON87419.pdf" }
                                    ]}
                                    title=""
                                    type="pdf"
                            />
                        </Seccion>
                    </div>

                    <!-- Departamento de Manejo de Organismos Genéticamente Modificados (DMOGM) -->
                    <div id="DCOS" class="scroll-mt-20">
                        <Seccion title="Departamento de Manejo de Organismos Genéticamente Modificados (DMOGM)" id="dmogm">
                            <h3 class="text-gray-800 font-bold text-lg mb-4">Monitoreo de eventos liberados comercialmente</h3>
                            <SeccionDeDocumentos
                                    items={[
                                        { title: "Monitoreo OGM 2024 Región Occidental", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/1.1-Monitoreo-OGM-2024-Reg-Occidental.pdf" },
                                        { title: "Monitoreo OGM 2024 Región Oriental", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/1.2-Monitoreo-OGM-2024-Reg-Oriental.pdf" }
                                    ]}
                                    title=""
                                    type="pdf"
                            />

                            <SeccionDeDocumentos
                                    items={[
                                        { title: "Autorizaciones de importación de materiales vegetales genéticamente modificados", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/2AUTOR1.pdf" },
                                        { title: "Listado de eventos aprobados y liberados comercialmente", url: "https://www.senave.gov.py/docs/bioseguridad/EVENTOS LIBERADOS COMERCIALMENTE EN EL PAIS- 4-MARZO 2026.pdf" },
                                        { title: "Archivo fotográfico de monitoreo de cultivos OGM", url: "https://www.senave.gov.py/wp-content/uploads/2024/12/4-Archivo-Fotográfico-DMOGM-1.docx" }
                                    ]}
                                    title=""
                                    type="pdf"
                            />

