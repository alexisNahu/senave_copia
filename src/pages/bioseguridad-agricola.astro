                                    <div class="mt-3 space-y-3">
                                        <div>
                                            <p><strong>Ing. Agr. Hugo Brüning</strong> - Director, Dirección de Bioseguridad Agrícola</p>
                                            <a href="mailto:hugo.bruning@senave.gov.py" class="text-green-600 hover:underline">hugo.bruning@senave.gov.py</a>
                                        </div>
                                        <div>
