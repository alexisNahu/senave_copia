                                        <div>
                                            <p><strong>Ing. Amb. Sergio Rodriguez</strong> - Tecnico de la Direccion de Bioseguridad Agrícola</p>
                                            <a href="mailto:sergio.rodriguez@senave.gov.py" class="text-green-600 hover:underline">sergio.rodriguez@senave.gov.py</a>
                                        </div>
                                        <div>
                                            <p><strong>Ing. Agr. Genaro Coronel</strong> - Asesor Técnico de la Dirección de Bioseguridad Agrícola</p>
                                            <a href="mailto:genaro.coronel@senave.gov.py" class="text-green-600 hover:underline">genaro.coronel@senave.gov.py</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </Seccion>
                    </div>
                </Seccion>
            </main>
        </div>
    </div>
</Layout>
