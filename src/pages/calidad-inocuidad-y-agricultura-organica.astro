---
import Layout from '../layouts/Layout.astro';
import Header from '../features/servicios/Header.astro';
---

<Layout>
    <Header title="Dirección de Calidad, Inocuidad y Agricultura Orgánica (DICAO)" />

    <section class="bg-[#E8F8EE] py-6 border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-5">
            <ul class="space-y-2.5 font-medium text-gray-800 text-sm">
                <li class="flex items-center gap-2.5">
                    <svg class="w-5 h-5 text-[#00A240] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <a href="#dciv" class="hover:text-[#00A240] transition-colors">Departamento de Calidad e Inocuidad de vegetales</a>
                </li>
                <li class="flex items-center gap-2.5">
                    <svg class="w-5 h-5 text-[#00A240] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <a href="#dtv" class="hover:text-[#00A240] transition-colors">Departamento de Trazabilidad Vegetal</a>
                </li>
                <li class="flex items-center gap-2.5">
                    <svg class="w-5 h-5 text-[#00A240] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <a href="#dao" class="hover:text-[#00A240] transition-colors">Departamento de Agricultura Orgánica</a>
                </li>
            </ul>
        </div>
    </section>

    <section class="py-12 md:py-16">
        <div class="max-w-7xl mx-auto px-5 text-gray-700 text-sm leading-relaxed space-y-12">

            <div class="rounded-lg overflow-hidden shadow-sm border border-gray-100">
                <img
                        src="https://www.senave.gov.py/wp-content/uploads/2024/09/Agroquimicos-1000x562-1.jpg"
                        alt="Dirección de Calidad, Inocuidad y Agricultura Orgánica"
                        class="w-full h-64 md:h-80 object-cover"
                />
            </div>

            <div class="bg-gray-50 border-l-4 border-[#00A240] px-5 py-4 rounded-r">
                <p class="text-gray-600 italic">
                    <span class="font-bold text-gray-800 not-italic block mb-1">Objetivo:</span>
                    Establecer las normas de calidad, inocuidad, y del sistema de producción orgánica, de los productos y subproductos vegetales y velar por el fiel cumplimiento de las mismas, a fin de minimizar los riesgos para la salud humana, animal, las plantas y el medio ambiente, tanto en las actividades nacionales y de importación.
                </p>
            </div>

            <section id="dciv" class="scroll-mt-6 space-y-4">
                <h2 class="text-xl font-bold text-[#00A240] border-b border-gray-100 pb-2">
                    Departamento de Calidad e Inocuidad de vegetales (DCIV)
                </h2>
                <ul class="space-y-2 pl-1 font-medium">
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Marco normativo</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">REQUISITOS TECNICOS DE CALIDAD E INOCUIDAD DE FRUTAS Y HORTALIZAS</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Registro nacional de habilitación y registro de locales de almacenamiento de productos vegetales destinados al consumo humano</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Registro nacional de habilitación y registro de locales de empaques de productos y subproductos de origen vegetal</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Instructivo "TES" - Habilitación de depósitos</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Instructivo "TES" - Habilitación y registro de secaderos de yerba mate</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">BUENAS PRACTICAS AGRICOLAS (BPA)</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Monitoreo de residuos de plaguicidas y otros contaminantes en productos vegetales</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Materiales Informativos y de divulgación</a>
                    </li>
                </ul>
            </section>

            <section id="dtv" class="scroll-mt-6 space-y-4">
                <h2 class="text-xl font-bold text-[#00A240] border-b border-gray-100 pb-2">
                    Departamento de Trazabilidad Vegetal (DTV)
                </h2>
                <p class="text-gray-600">
                    <span class="font-bold text-gray-800">Objetivo:</span> Mantener un conocimiento actualizado sobre la situación, origen y destino de los productos y subproductos vegetales para cooperar a resolver imprevistos ante las normativas vigentes en materia de la trazabilidad de los mismos.
                </p>
                <ul class="space-y-2 pl-1 font-medium">
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Marco normativo</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Guia para registro y habilitación del productor de rubros hortícolas y frutícolas en el SIGEST</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Manual técnico de requisitos de personas físicas para el transporte de frutas y hortalizas en estado</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">MANUAL DE OPERACION / USO DE SISTEMA "SIGEST" para el transporte de frutas y hortalizas en estado fresco, con el fin de trazabilidad (Res, sefave N° 511/19)</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Reglamento específico para la habilitación de centros clasificadores de granos - Silos y centros</a>
                    </li>
                </ul>
            </section>

            <section id="dao" class="scroll-mt-6 space-y-4">
                <h2 class="text-xl font-bold text-[#00A240] border-b border-gray-100 pb-2">
                    Departamento de Agricultura Orgánica (DAO)
                </h2>
                <p class="text-gray-600">
                    <span class="font-bold text-gray-800">Objetivo:</span> Asegurar el cumplimiento de las normas y reglamentaciones que rigen a la producción y comercialización de productos y subproductos procedentes del sistema de la agricultura orgánica, contribuyendo con el desarrollo de un mercado diferenciado de productos agrícolas.
                </p>
                <ul class="space-y-2 pl-1 font-medium">
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Marco normativo</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Registro de Operadores certificadores y SPG</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">Enlace de interés / Sitios Técnicos</a>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#00A240] shrink-0"></span>
                        <a href="#" class="text-[#00A240] underline hover:text-[#00560E]">SISTEMA PARAGUAYO DE PRODUCCION ORGANICA</a>
                    </li>
                </ul>
            </section>

            <section class="pt-8 border-t border-gray-100">
                <h2 class="text-lg font-bold text-gray-800 mb-3">Contactos</h2>
                <div class="bg-gray-50 rounded-lg p-5 text-xs space-y-1.5 text-gray-600 max-w-2xl">
                    <p><span class="font-semibold text-gray-800 text-sm block mb-1">Oficina Central DICAO</span></p>
                    <p><span class="font-semibold text-gray-800">Dirección:</span> Luis A. de Herrera 1052 esq. Yegros. Edif. Inter Express - Piso 17</p>
                    <p><span class="font-semibold text-gray-800">Correo / Teléfono:</span> (021) 441491 int. 324</p>
                    <p><span class="font-semibold text-gray-800">E-mail:</span> <a href="mailto:dicao@senave.gov.py" class="text-[#00A240] hover:underline">dicao@senave.gov.py</a></p>
                </div>
            </section>

        </div>
    </section>
</Layout>
