---
import Layout from '../layouts/Layout.astro';
import Header from '../features/servicios/Header.astro';
import SidebarNav from '../components/SidebarNav.astro';
import PrincipalImage from "../components/PrincipalImage.astro";

// Items de navegación vinculados a las IDs de las secciones correspondientes
const navItems = [
    { href: '#dciv', label: 'Calidad e Inocuidad de Vegetales (DCIV)' },
    { href: '#dtv', label: 'Trazabilidad Vegetal (DTV)' },
    { href: '#dao', label: 'Agricultura Orgánica (DAO)' },
];
---

<Layout>
    <Header title="Dirección de Calidad, Inocuidad y Agricultura Orgánica (DICAO)" />


    <PrincipalImage src="https://www.senave.gov.py/wp-content/uploads/2024/09/Agroquimicos-1000x562-1.jpg" alt="Dirección de Calidad, Inocuidad y Agricultura Orgánica"/>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col lg:flex-row gap-10">

            <SidebarNav navItems={navItems} />

            <main class="flex-1 text-sm text-gray-700 space-y-12 leading-relaxed">

                <div class="bg-gray-50 border-l-4 border-[#00A240] px-5 py-4 rounded-r shadow-xs">
                    <p class="text-gray-600 italic">
                        <span class="font-bold text-gray-800 not-italic block mb-1 text-sm uppercase tracking-wider">Objetivo:</span>
                        Establecer las normas de calidad, inocuidad, y del sistema de producción orgánica, de los productos y subproductos vegetales y velar por el fiel cumplimiento de las mismas, a fin de minimizar los riesgos para la salud humana, animal, las plantas y el medio ambiente, tanto en las actividades nacionales y de importación.
                    </p>
                </div>

                <section id="dciv" class="scroll-mt-6 space-y-6 bg-white p-6 rounded-2xl border border-gray-100 shadow-xs">
                    <h2 class="text-xl font-bold text-[#00A240] pb-2 border-b-2 border-gray-100">
                        Departamento de Calidad e Inocuidad de vegetales (DCIV)
                    </h2>

                    <div class="space-y-3">
                        <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2 pl-3 font-medium">
                            {[
                                { label: "Marco normativo", href: "#" },
                                { label: "REQUISITOS TECNICOS DE CALIDAD E INOCUIDAD DE FRUTAS Y HORTALIZAS", href: "#" },
                                { label: "Registro nacional de habilitación y registro de locales de almacenamiento de productos vegetales destinados al consumo humano", href: "#" },
                                { label: "Registro nacional de habilitación y registro de locales de empaques de productos y subproductos de origen vegetal", href: "#" },
                                { label: "Instructivo \"TES\" - Habilitación de depósitos", href: "#" },
                                { label: "Instructivo \"TES\" - Habilitación y registro de secaderos de yerba mate", href: "#" },
                                { label: "BUENAS PRACTICAS AGRICOLAS (BPA)", href: "#" },
                                { label: "Monitoreo de residuos de plaguicidas y otros contaminantes en productos vegetales", href: "#" },
                                { label: "Materiales Informativos y de divulgación", href: "#" }
                            ].map((item) => (
                                    <li class="flex items-start gap-2">
                                        <span class="text-[#00A240] font-bold mt-0.5">•</span>
                                        <a href={item.href} class="text-[#00A240] underline hover:text-green-700 leading-tight">{item.label}</a>
                                    </li>
                            ))}
                        </ul>
                    </div>
                </section>

                <section id="dtv" class="scroll-mt-6 space-y-6 bg-white p-6 rounded-2xl border border-gray-100 shadow-xs">
                    <h2 class="text-xl font-bold text-[#00A240] pb-2 border-b-2 border-gray-100">
                        Departamento de Trazabilidad Vegetal (DTV)
                    </h2>

                    <div class="bg-gray-50/60 p-4 rounded-xl border border-gray-100 text-xs">
                        <p class="text-gray-600">
                            <span class="font-bold text-gray-800 text-sm block mb-0.5">Objetivo:</span>
                            Mantener un conocimiento actualizado sobre la situación, origen y destino de los productos y subproductos vegetales para cooperar a resolver imprevistos ante las normativas vigentes en materia de la trazabilidad de los mismos.
                        </p>
                    </div>

                    <div class="space-y-3">
                        <ul class="space-y-2.5 pl-3 font-medium">
                            {[
                                { label: "Marco normativo", href: "#" },
                                { label: "Guia para registro y habilitación del productor de rubros hortícolas y frutícolas en el SIGEST", href: "#" },
                                { label: "Manual técnico de requisitos de personas físicas para el transporte de frutas y hortalizas en estado", href: "#" },
                                { label: "MANUAL DE OPERACION / USO DE SISTEMA \"SIGEST\" para el transporte de frutas y hortalizas en estado fresco, con el fin de trazabilidad (Res. SENAVE N° 511/19)", href: "#" },
                                { label: "Reglamento específico para la habilitación de centros clasificadores de granos - Silos y centros", href: "#" }
                            ].map((item) => (
                                    <li class="flex items-start gap-2">
                                        <span class="text-[#00A240] font-bold mt-0.5">•</span>
                                        <a href={item.href} class="text-[#00A240] underline hover:text-green-700">{item.label}</a>
                                    </li>
                            ))}
                        </ul>
                    </div>
                </section>

                <section id="dao" class="scroll-mt-6 space-y-6 bg-white p-6 rounded-2xl border border-gray-100 shadow-xs">
                    <h2 class="text-xl font-bold text-[#00A240] pb-2 border-b-2 border-gray-100">
                        Departamento de Agricultura Orgánica (DAO)
                    </h2>

                    <div class="bg-gray-50/60 p-4 rounded-xl border border-gray-100 text-xs">
                        <p class="text-gray-600">
                            <span class="font-bold text-gray-800 text-sm block mb-0.5">Objetivo:</span>
                            Asegurar el cumplimiento de las normas y reglamentaciones que rigen a la producción y comercialización de productos y subproductos procedentes del sistema de la agricultura orgánica, contribuyendo con el desarrollo de un mercado diferenciado de productos agrícolas.
                        </p>
                    </div>

                    <div class="space-y-3">
                        <ul class="space-y-2.5 pl-3 font-medium">
                            {[
                                { label: "Marco normativo", href: "#" },
                                { label: "Registro de Operadores certificadores y SPG", href: "#" },
                                { label: "Enlace de interés / Sitios Técnicos", href: "#" },
                                { label: "SISTEMA PARAGUAYO DE PRODUCCION ORGANICA", href: "#" }
                            ].map((item) => (
                                    <li class="flex items-start gap-2">
                                        <span class="text-[#00A240] font-bold mt-0.5">•</span>
                                        <a href={item.href} class="text-[#00A240] underline hover:text-green-700">{item.label}</a>
                                    </li>
                            ))}
                        </ul>
                    </div>
                </section>

                <section class="pt-4">
                    <h2 class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        Canales de Comunicación
                    </h2>
                    <div class="bg-linear-to-r from-gray-50 to-white rounded-2xl border border-gray-150 p-5 text-xs space-y-2 text-gray-600 max-w-2xl shadow-xs">
                        <p><span class="font-bold text-gray-800 text-sm block mb-1">Oficina Central DICAO</span></p>
                        <p><span class="font-semibold text-gray-800">Dirección:</span> Luis A. de Herrera 1052 esq. Yegros. Edif. Inter Express - Piso 17</p>
                        <p><span class="font-semibold text-gray-800">Correo / Teléfono:</span> (0983) 634204</p>
                        <p><span class="font-semibold text-gray-800">E-mail:</span> <a href="mailto:dicao@senave.gov.py" class="text-[#00A240] hover:underline font-medium">dicao@senave.gov.py</a></p>
                    </div>
                </section>

            </main>
        </div>
    </div>
</Layout>
