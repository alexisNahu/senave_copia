            { text: "Informe de Rendición de Cuentas al ciudadano Enero a Marzo 2024 (Pdf)", url: "https://www.senave.gov.py/docs/rendicion-de-cuentas-al-ciudadano/Informe-de-Rendicion-de-Cuentas-al-ciudadano-Enero-a-Marzo-2024.pdf", type: "pdf" },
            { text: "Informe de Rendicion de Cuentas al ciudadano Enero a Marzo 2024 (Excel)", url: "https://www.senave.gov.py/docs/rendicion-de-cuentas-al-ciudadano/Informe de Rendicion de Cuentas al ciudadano Enero a Marzo 2024 - copia.xlsx", type: "excel" }
        ]
