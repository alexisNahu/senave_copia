// Ordenamos los años de forma descendente de manera segura
const sortedData = [...rendicionData].sort((a, b) => b.year - a.year);
---

<Layout title="Rendición de cuentas al ciudadano">
    <Header title="consulta" />

    <div class="max-w-5xl mx-auto px-4 py-12 pb-20">
        <div class="mb-2 text-[#00a240] text-[22px] font-semibold tracking-wide border-b-2 border-[#00a240] pb-1 inline-block">
            Rendición de Cuentas al Ciudadano
        </div>
        <p class="text-gray-600 mb-8 mt-2">
            Listado de informes, resoluciones y matrices de rendición de cuentas presentados por el SENAVE.
        </p>

        <div class="space-y-3">
            {sortedData.map((item) => (
                    <details class="group border border-gray-200 rounded-lg overflow-hidden bg-white shadow-sm transition-all duration-200">
                        <summary class="flex items-center justify-between px-6 py-4 bg-gray-50 hover:bg-[#00a240] hover:text-white cursor-pointer font-bold text-lg transition-colors list-none">
                            <span>{item.year}</span>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5 transform transition-transform duration-200 group-open:rotate-180">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                            </svg>
                        </summary>

                        <div class="p-5 bg-white border-t border-gray-100">
                            <ul class="divide-y divide-gray-100">
                                {item.docs.map((doc) => (
                                        <li>
                                            <a
                                                    href={doc.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="flex items-center gap-4 py-3.5 px-2 text-sm text-gray-700 hover:text-[#00a240] hover:bg-gray-50/70 transition-all rounded-md group"
                                            >
                                                {doc.type === 'excel' && (
                                                        <div class="p-2 bg-green-50 text-green-600 rounded-lg group-hover:bg-green-100 transition-colors">
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h1.5H3.375Zm17.25 0c.621 0 1.125-.504 1.125-1.125M20.625 19.5h-1.5h1.5Zm-1.5-12h-1.5M20.625 7.5c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125m-17.25 0a1.125 1.125 0 0 1-1.125-1.125V3.375c0-.621.504-1.125 1.125-1.125h9.75c.621 0 1.125.504 1.125 1.125v3.375m7.5 0h-1.5m1.5 0v1.5m0-1.5v-1.5m0 1.5h1.5m-10.5-3v1.5m0-1.5h-1.5m1.5 0h1.5m-3 3v1.5m0-1.5h-1.5m1.5 0h1.5m6 3v1.5m0-1.5h-1.5m1.5 0h1.5m-3 3v1.5m0-1.5h-1.5m1.5 0h1.5" />
                                                            </svg>
                                                        </div>
                                                )}
                                                {doc.type === 'word' && (
                                                        <div class="p-2 bg-blue-50 text-blue-600 rounded-lg group-hover:bg-blue-100 transition-colors">
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                                                            </svg>
                                                        </div>
                                                )}
                                                {doc.type === 'pdf' && (
                                                        <div class="p-2 bg-red-50 text-red-500 rounded-lg group-hover:bg-red-100 transition-colors">
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                                                            </svg>
                                                        </div>
                                                )}

                                                <span class="font-medium group-hover:underline transition-all">
                                            {doc.text}
                                        </span>
                                            </a>
                                        </li>
                                ))}
                            </ul>
                        </div>
                    </details>
            ))}
        </div>
    </div>
</Layout>

<style>
    /* Remueve la flecha por defecto de <summary> en navegadores basados en Webkit/Firefox */
    summary::-webkit-details-marker {
        display: none;
    }
    summary {
        list-style: none;
    }
</style>
