            { text: "Informe de Rendicion de Cuentas al Ciudadano – Enero a Marzo 2023", url: "https://www.senave.gov.py/docs/rendicion-de-cuentas-al-ciudadano/Informe de Rendicion de Cuentas al Ciudadano - Enero a Marzo 2023.xlsx", type: "excel" },
            { text: "Resolución Nº 106/2023 Plan de Rendición de Cuentas al Ciudadano 2023", url: "http://web.senave.gov.py:8081/docs/resoluciones/senave/web/9a16a43bf44ce77032f9ccf0be7dc8b2.pdf", type: "pdf" }
