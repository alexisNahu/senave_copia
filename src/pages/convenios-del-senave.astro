---

<Layout>
    <Header title="Convenios del Senave" />

    <div class="max-w-5xl mx-auto px-4 py-12 pb-20">

        <div class="mb-2 text-[#00a240] text-[22px] font-semibold tracking-wide border-b-2 border-[#00a240] pb-1 inline-block">
            Convenios del SENAVE
        </div>
        <p class="text-gray-600 mb-8 mt-2">
            Listado de convenios, acuerdos y memorandos de cooperación interinstitucional suscritos por el SENAVE.
        </p>

        <div class="space-y-3">
            {years.map((year) => (
                    <details class="group border border-gray-200 rounded-lg overflow-hidden">
                        <summary class="flex items-center justify-between px-6 py-4 bg-gray-50 hover:bg-[#00a240] hover:text-white cursor-pointer font-bold text-lg transition-colors list-none">
                            <span>{year}</span>
                            <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </summary>
                        <ul class="divide-y divide-gray-100 bg-white">
                            {convenios[year].map((item) => (
                                    <li class="flex items-center gap-3 px-6 py-3 hover:bg-green-50 transition-colors text-sm">
                                        <svg class="w-4 h-4 text-[#00a240] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20H7a2 2 0 01-2-2V6a2 2 0 012-2h7l5 5v9a2 2 0 01-2 2z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6M9 16h4" />
                                        </svg>

                                        <a
                                                href={item.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="text-gray-700 hover:text-[#00a240] hover:underline flex-1"
                                        >
                                            {item.nombre}
                                        </a>
                                    </li>
                            ))}
                        </ul>
                    </details>
            ))}
        </div>

    </div>
</Layout>
