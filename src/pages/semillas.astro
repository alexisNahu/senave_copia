---
import Layout from '../layouts/Layout.astro';
import Header from '../features/servicios/Header.astro';
import SidebarNav from '../components/SidebarNav.astro';
import SeccionDeDocumentos from "../components/SeccionDeDocumentos.astro";

// Importación de todos los objetos y arrays de datos simulados (mock)
import * as mockData from '../features/semillas/mock';
import Seccion from "../components/Seccion.astro";

const navItems = [
    { href: '#dpuv', label: 'Protección y Uso de Variedades (DPUV)' },
    { href: '#nmea', label: 'Normas Mínimas de Ensayos de Evaluación Agronómica y de Calidad por Especie'},
    { href: '#dcs', label: 'Certificación de Semillas (DCS)' },
    { href: '#dcos', label: 'Comercio de Semillas (DCOS)' },
];
---

<Layout>
    <Header title="Semillas" />

    <div class="w-full overflow-hidden bg-gray-900">
        <img
                src="https://www.senave.gov.py/wp-content/uploads/2024/09/semillasSA.jpg"
                alt="Semillas SENAVE"
                class="w-full object-cover max-h-80 animate-fade-in duration-700"
        />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col lg:flex-row gap-10">

            <SidebarNav navItems={navItems} />

            <main class="flex-1 text-sm text-gray-700 space-y-12 leading-relaxed content-fade-in">

                <Seccion title="Departamento de Protección y Uso de Variedades (DPUV)" id="dpuv">
                    <SeccionDeDocumentos items={[
                        {title: 'LISTADO DE EVALUADORES 2025', url: '#'},
                        {title: 'ANEXO I - LISTADO DE POBLACIONES CRIOLLAS Y NATIVAS. Julio 2024', url: '#'},
                        {title: 'TASAS', url: '#'}
                    ]} title="" type="pdf" />

                    <SeccionDeDocumentos title="Boletines: " type="enlace" items={[
                        {url: '#', title: 'Boletín Mayo 2026 (PDF)'},
                        {url: '#', title: 'Boletín Mayo 2026 (Excel)'}
                    ]}/>

                    <SeccionDeDocumentos title="Procedimientos: " type="word" items={mockData.procedimientos_departamento_proteccion}/>

                    <SeccionDeDocumentos title="Formularios: " type="word" items={mockData.formularios_departamento_proteccion}/>

                    <SeccionDeDocumentos items={mockData.descripciones_departamento_proteccion} title="Descriptores: " type="word" />
                </Seccion>


                <Seccion title="Normas Mínimas de Ensayos de Evaluación Agronómica y de Calidad por Especie" id="nmea">
                    <SeccionDeDocumentos items={mockData.normasMinimas} title="" type="punto" />

                    <SeccionDeDocumentos items={mockData.listasTestigos} title="Lista de testigos para ensayos de evaluación agronómica y de calidad" type="pdf" />
                    <SeccionDeDocumentos items={mockData.descriptoresVarietales} title="Descriptores varietales" type="excel" />
                </Seccion>

                <Seccion title="Departamento de Certificación de Semillas (DCS)" id="dcs">
                    <SeccionDeDocumentos items={mockData.procedimientosDcs} title="Procedimientos: " type="pdf" />
                    <SeccionDeDocumentos items={mockData.formulariosDcs} title="Formularios: " type="word" />
                </Seccion>


                <Seccion
                    title='Departamento de Comercio de Semillas (DCOS)'
                    id="dcos"
                >
                    <SeccionDeDocumentos items={mockData.procedimientos_dcos} title="Procedimientos: " type="pdf" />
                    <SeccionDeDocumentos items={mockData.formularios_dcos} title="Formularios: " type="word" />
                </Seccion>
            </main>
        </div>
    </div>
</Layout>

<style>
    /* Animación de entrada suave para el contenido */
    .content-fade-in {
        animation: fadeInUp 0.6s ease-out forwards;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
