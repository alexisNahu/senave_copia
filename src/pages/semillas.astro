---
import Layout from '../layouts/Layout.astro';
import Header from '../features/servicios/Header.astro';
import SidebarNav from '../components/SidebarNav.astro';
import SeccionDeDocumentos from "../components/SeccionDeDocumentos.astro";

// Importación de todos los objetos y arrays de datos simulados (mock)
import {
    procedimientos_departamento_proteccion,
    formularios_departamento_proteccion,
    descripciones_departamento_proteccion,
    normasMinimas,
    listasTestigos,
    descriptoresVarietales,
    procedimientosDcs,
    formulariosDcs,
    procedimientos_dcos,
    formularios_dcos
} from '../features/semillas/mock';

const navItems = [
    { href: '#dpuv', label: 'Protección y Uso de Variedades (DPUV)' },
    { href: '#nmea', label: 'Normas Mínimas de Ensayos de Evaluación Agronómica y de Calidad por Especie'},
    { href: '#dcs', label: 'Certificación de Semillas (DCS)' },
    { href: '#dcos', label: 'Comercio de Semillas (DCOS)' },
];
---

<Layout>
    <Header title="Semillas" />

    <div class="w-full overflow-hidden bg-gray-900">
        <img
                src="https://www.senave.gov.py/wp-content/uploads/2024/09/semillasSA.jpg"
                alt="Semillas SENAVE"
                class="w-full object-cover max-h-80 animate-fade-in duration-700"
        />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col lg:flex-row gap-10">

            <SidebarNav navItems={navItems} />

            <main class="flex-1 text-sm text-gray-700 space-y-12 leading-relaxed content-fade-in">

                <section id="dpuv" class="scroll-mt-6 space-y-6 bg-white p-6 rounded-2xl border border-gray-100 shadow-xs transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
                    <h2 class="text-xl font-bold text-[#00A240] pb-2 border-b-2 border-gray-100 flex items-center gap-2 group">
                        <span class="w-1.5 h-5 bg-[#00A240] rounded-full inline-block transform transition-transform group-hover:scale-y-120"></span>
                        Departamento de Protección y Uso de Variedades (DPUV)
                    </h2>

                    <SeccionDeDocumentos items={[
                        {title: 'LISTADO DE EVALUADORES 2025', url: '#'},
                        {title: 'ANEXO I - LISTADO DE POBLACIONES CRIOLLAS Y NATIVAS. Julio 2024', url: '#'},
                        {title: 'TASAS', url: '#'}
                    ]} title="" type="pdf" />

                    <SeccionDeDocumentos title="Boletines: " type="enlace" items={[
                        {url: '#', title: 'Boletín Mayo 2026 (PDF)'},
                        {url: '#', title: 'Boletín Mayo 2026 (Excel)'}
                    ]}/>

                    <SeccionDeDocumentos title="Procedimientos: " type="word" items={procedimientos_departamento_proteccion}/>

                    <SeccionDeDocumentos title="Formularios: " type="word" items={formularios_departamento_proteccion}/>

                    <SeccionDeDocumentos items={descripciones_departamento_proteccion} title="Descriptores: " type="word" />
                </section>

                <section id="nmea" class="scroll-mt-6 space-y-6 bg-white p-6 rounded-2xl border border-gray-100 shadow-xs transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
                    <h2 class="text-xl font-bold text-[#00A240] pb-2 border-b-2 border-gray-100 flex items-center gap-2 group">
                        <span class="w-1.5 h-5 bg-[#00A240] rounded-full inline-block transform transition-transform group-hover:scale-y-120"></span>
                        Normas Mínimas de Ensayos de Evaluación Agronómica y de Calidad por Especie
                    </h2>

                    <SeccionDeDocumentos items={normasMinimas} title="" type="punto" />

                    <SeccionDeDocumentos items={listasTestigos} title="Lista de testigos para ensayos de evaluación agronómica y de calidad" type="pdf" />
                    <SeccionDeDocumentos items={descriptoresVarietales} title="Descriptores varietales" type="excel" />
                </section>

                <section id="dcs" class="scroll-mt-6 space-y-6 bg-white p-6 rounded-2xl border border-gray-100 shadow-xs transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
                    <h2 class="text-xl font-bold text-[#00A240] pb-2 border-b-2 border-gray-100 flex items-center gap-2 group">
                        <span class="w-1.5 h-5 bg-[#00A240] rounded-full inline-block transform transition-transform group-hover:scale-y-120"></span>
                        Departamento de Certificación de Semillas (DCS)
                    </h2>

                    <SeccionDeDocumentos items={procedimientosDcs} title="Procedimientos: " type="pdf" />
                    <SeccionDeDocumentos items={formulariosDcs} title="Formularios: " type="word" />
                </section>

                <section id="dcos" class="scroll-mt-6 space-y-6 bg-white p-6 rounded-2xl border border-gray-100 shadow-xs transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
                    <h2 class="text-xl font-bold text-[#00A240] pb-2 border-b-2 border-gray-100 flex items-center gap-2 group">
                        <span class="w-1.5 h-5 bg-[#00A240] rounded-full inline-block transform transition-transform group-hover:scale-y-120"></span>
                        Departamento de Comercio de Semillas (DCOS)
                    </h2>

                    <SeccionDeDocumentos items={procedimientos_dcos} title="Procedimientos: " type="pdf" />
                    <SeccionDeDocumentos items={formularios_dcos} title="Formularios: " type="word" />
                </section>
            </main>
        </div>
    </div>
</Layout>

<style>
    /* Animación de entrada suave para el contenido */
    .content-fade-in {
        animation: fadeInUp 0.6s ease-out forwards;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
