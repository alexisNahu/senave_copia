---
import Layout from '../layouts/Layout.astro';
import Header from '../features/servicios/Header.astro';
import SidebarNav from '../components/SidebarNav.astro';
import Seccion from "../components/Seccion.astro";
import Remarcable from "../components/Remarcable.astro";
import SeccionDeDocumentos from "../components/SeccionDeDocumentos.astro";
import * as mockData from "../core/mocks/agroquimicos";

// Items de navegación vinculados a las IDs de las secciones correspondientes
const navItems = [
    { href: '#entidad-comercial', label: 'Entidad comercial' },
    { href: '#habilitacion-de-depositos', label: 'Habilitación de depósitos' },
    { href: '#habilitacion-de-transporte', label: 'Habilitación de transporte' },
    { href: '#laboratorios-reconocidos-habilitados', label: 'Laboratorios reconocidos / habilitados' },
    { href: '#profesionales', label: 'Profesionales' },
    { href: '#padron-de-pilotos-de-aeronaves-agricolas', label: 'Padrón de Pilotos de aeronaves agrícolas' },
    { href: '#importaciones-exportaciones', label: 'Importaciones / exportaciones' },
    { href: '#productos-fitosanitarios', label: 'Productos fitosanitarios' },
    { href: '#fertilizantes-inoculantes-biofertilizantes-enmiendas', label: 'Fertilizantes, inoculantes, biofertilizantes, enmiendas' },
    { href: '#muestra', label: 'Muestra' },
    { href: '#extension-de-nombre-comercial', label: 'Extensión de nombre comercial' },
    { href: '#extension-de-fecha-de-validez', label: 'Extensión de fecha de validez' },
    { href: '#manejo-de-envases-vacios-y-embalajes-de-insumos-agricolas', label: 'Manejo de envases vacíos y embalajes de insumos agrícolas' },
    { href: '#convenio-de-rotterdam', label: 'Convenio de Rotterdam' },
    { href: '#listado-de-productos-prohibidos-en-paraguay', label: 'Listado de Productos Prohibidos en Paraguay' },
    { href: '#capacitaciones', label: 'Capacitaciones' },
    { href: '#informaciones-y-materiales-audiovisuales', label: 'Informaciones y materiales audiovisuales' }
];
---

<Layout>
    <Header title="Dirección de Calidad, Inocuidad y Agricultura Orgánica (DICAO)" />

    <div class="w-full">
        <img
                src="https://www.senave.gov.py/wp-content/uploads/2024/09/Agroquimicos-1000x562-1.jpg"
                alt="Dirección de Calidad, Inocuidad y Agricultura Orgánica"
                class="w-full object-cover max-h-48 md:max-h-64"
        />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col lg:flex-row gap-10">

            <SidebarNav navItems={navItems} />

            <main class="flex-1 text-sm text-gray-700 space-y-12 leading-relaxed">

                <Seccion title="Dirección de Agroquímicos e Insumos Agrícolas (DAG)" id="dag">
                    <Remarcable
                            title="Objetivo: "
                            text="Establecer y velar por el cumplimiento de las normas, la calidad y eficacia de los productos fitosanitarios, fertilizantes, biofertilizantes, inoculantes y enmiendas como insumos agrícolas, así como el manejo y uso seguro de plaguicidas y la gestión de los residuos de insumos agrícolas."
                    />
                    <p class="mb-3">Unidades dependientes</p>
                    <ul class="list-disc list-inside space-y-2 ml-4">
                        <li>Departamento de Control y Evaluación de Insumos Agrícolas (DCEI)</li>
                        <li>Departamento de Evaluación y Mitigación de Riesgos de los Plaguicidas (DEyMRP)</li>
                        <li>Departamento de Divulgación y Manejo Seguro de los Plaguicidas (DDyMSP)</li>
                        <li>Comisión Técnica Evaluadora (CTE)</li>
                    </ul>
                </Seccion>

                <Seccion title="Entidad comercial" id="entidad-comercial">
                    <SeccionDeDocumentos title="" type="enlace" items={[
                        {title: "Requisitos de Registro de Entidades Comerciales", url: "https://www.senave.gov.py/docs/agroquimicos/REQUISITOS%20DE%20ENTIDADES%20COMERCIALES.pdf" },
                        {title: "Proceso de Registro en el TES", url: "https://www.senave.gov.py/wp-content/uploads/2024/10/PROCESO-DE-REGISTRO-EN-EL-TES.pdf"}
                    ]}/>
                    <SeccionDeDocumentos items={mockData.formularios_entidad_comercial} title="Formularios: " type="word" />
                </Seccion>

                <Seccion title="Habilitación de depósitos" id="habilitacion-de-depositos">
                    <SeccionDeDocumentos items={[
                        {title: 'Requisitos para habilitación de Depósitos (Entidad Comercual A.5)', url: 'https://www.senave.gov.py/docs/agroquimicos/REQUISITOS%20DE%20ENTIDADES%20COMERCIALES%20-%20HABILITACION%20DE%20DEPOSITOS.pdf'}
                    ]} title="" type="enlace" />
                    <SeccionDeDocumentos items={mockData.formularios_habilitacion_depositos} title="Formularios: " type="word" />
                </Seccion>

                <Seccion title="Habilitación de transporte" id="habilitacion-de-transporte">
                    <SeccionDeDocumentos items={[
                        {title: 'Requisitos para la habilitación de transportes', url: '#'}
                    ]} title="" type="enlace" />
                    <SeccionDeDocumentos items={[
                        {title: 'Nota proforma. Solicitud de habilitación de transportes', url: '#'},
                        {title: 'Ficha de verificación previa para la habilitación de vehículos para el transporte de agroquímicos', url: '#'},
                    ]} title="Formularios: " type="word" />
                </Seccion>

                <Seccion title="Laboratorios reconocidos/habilitados" id="laboratorios-reconocidos-habilitados">
                    <SeccionDeDocumentos items={mockData.requisitos_laboratorios_reconocidos} title="Registro de laboratorios reconocidos" type="pdf" />
                    <SeccionDeDocumentos items={mockData.formularios_laboratorios_reconocidos} title="Formularios" type="pdf" />

                    <SeccionDeDocumentos items={mockData.requisitos_laboratorios_habilitados} title="Registro de laboratorios habilitados (nacionales)" type="pdf" />
                    <SeccionDeDocumentos items={mockData.formularios_laboratorios_habilitados} title="Formularios" type="pdf" />

                    <SeccionDeDocumentos items={mockData.registro_laboratorios_toxicologia} title="Registro de laboratorios toxicología y ecotoxicología (BPL)" type="word" />
                </Seccion>

                <Seccion title="Profesionales" id="profesionales">
                    <SeccionDeDocumentos items={mockData.profesionales} title="" type="enlace" />
                </Seccion>

                <Seccion title="Padrón de Pilotos de aeronaves agrícolas" id="padron-de-pilotos-de-aeronaves-agricolas">
                    <SeccionDeDocumentos items={mockData.pilotos} title="" type="enlace" />
                </Seccion>

                <Seccion title="Productos fitosanitarios" id="productos-fitosanitarios">
                    <SeccionDeDocumentos
                            items={mockData.documentos_generales}
                            title="Documentos generales para todas las categorías"
                            type="word"
                    />
                    <Seccion title="PRODUCTO FORMULADO" id="produto-formulado">
                        <SeccionDeDocumentos
                                items={mockData.definitivo_producto_formulado}
                                title="Categoría Definitivo Resolución N° 446/06 - 1. Producto Formulado"
                                type="word"
                        />

                        <SeccionDeDocumentos
                                items={mockData.presentacion_cuerpo_3}
                                title="PRESENTACIÓN DEL CUERPO III - CUERPO TÉCNICO FORMA FÍSICA"
                                type="word"
                        />

                        <SeccionDeDocumentos
                                items={mockData.forma_digital}
                                title="Forma digital"
                                type="punto"
                        />
                    </Seccion>

                    <Seccion title="2. SUSTANCIA ACTIVA GRADO TÉCNICO EQUIVALENTE (REGISTRO/ SOPORTE)" id="sustancia-activa">
                        <SeccionDeDocumentos
                                items={mockData.sustancia_activa}
                                type="punto"
                                title=""
                        />
                        <SeccionDeDocumentos
                                items={mockData.presentacion_cuerpo_32}
                                title="PRESENTACIÓN DEL CUERPO III - CUERPO TÉCNICO FORMA FÍSICA"
                                type="word"
                        />
                        <SeccionDeDocumentos items={[
                            {title: 'FOR-CTE-066 – ANEXO VII INDICE ESTUDIOS SOLICITADOS EN EL CUERPO III CUERPO TECNICO PARA EL REGISTRO DE SUSTANCIA ACTIVA QUIMICA GRADO TÉCNICO EQUIVALENTE', url: '#'}
                        ]} title="Forma digiral" type="punto" />
                    </Seccion>

                    <SeccionDeDocumentos items={[
                        {title: ' FOR-CTE-068 – SOLICITUD DE REGISTRO DE PRODUCTOS ACBM', url: '#'},
                        {title: ' FOR-CTE-006 CHECK LIST BIOLOGICOS', url: '#'}
                    ]} title="CATEGORÍA DEFINITIVA PRODUCTOS DE AGENTE DE CONTROL BIOLOGICO MICROBIANO (ACBM) RESOLUCIÓN N° 446/06- ANEXO 6" type="punto"/>



                    <SeccionDeDocumentos
                            items={mockData.control_biologico_microbiano}
                            title="Categoría Definitiva Productos de Agente de Control Biológico Microbiano (ACBM) Resolución N° 446/06 - Anexo 6"
                            type="word"
                    />

                    <SeccionDeDocumentos
                            items={mockData.trato_diferenciado}
                            title="Categoría Definitiva por Trato Diferenciado Resolución N° 131/18"
                            type="word"
                    />

                    <Seccion title="Categoría Experimental Resolución N° 600/09" id="categoria-experimental">
                        <SeccionDeDocumentos
                                items={mockData.experimental_producto_formulado}
                                title="1. Producto Formulado"
                                type="word"
                        />

                        <SeccionDeDocumentos
                                items={[
                                    {
                                        title: 'FOR-CTE-061 – ANEXO II RESUMEN – ESTUDIOS SOLICITADOS EN EL CUERPO III – CUERPO TECNICO – PARA EL REGISTRO DE PRODUCTOS FORMULADOS EN BASE A SUSTANCIA ACTIVA QUIMICA Y BIOQUIMICA NUEVA SIN ANTECEDENTES DE USO (Forma Física)',
                                        url: 'https://www.senave.gov.py/docs/agroquimicos/registros-agroquimicos/61_FOR-CTE-061%20ANEXO%20II%20RESUMEN%20-%20ESTUDIOS%20SOLICITADOS%20EN%20EL%20CUERPO%20III%20%E2%80%93%20CUERPO%20TECNICO%20-%20PARA%20EL%20REGISTRO%20DE%20PRODUCTOS%20FORMULADOS%20EN%20BASE%20A%20SUSTANCIA%20ACTIVA%20QUIMICA%20Y%20BIOQUIMICA%20NUEVA%20SIN%20ANTECEDENTES%20DE%20USO.docx'
                                    },
                                ]}
                                title="Forma Física"
                                type="word"
                        />

                        <SeccionDeDocumentos
                                items={[
                                    {
                                        title: 'FOR-CTE-065 – ANEXO VI INDICE ESTUDIOS SOLICITADOS EN EL CUERPO III CUERPO TECNICO PARA EL REGISTRO DE PRODUCTOS FORMULADOS EN BASE A SUSTANCIA ACTIVA QUIMICA Y BIOQUIMICA NUEVA SIN ANTECEDENTES DE USO (Forma Digital)',
                                        url: 'https://www.senave.gov.py/docs/agroquimicos/registros-agroquimicos/65_FOR-CTE-064-ANEXO-VI-INDICE-ESTUDIOS-SOLICITADOS-EN-EL-CUERPO-III-CUERPO-TECNICO-PARA-EL-REGISTRO-DE-PRODUCTOS-FORMULADOS-EN-BASE-A-SUSTANCIA-ACTIVA-QUIMICA-Y-BIOQUIMICA-NUEVA-SIN-ANTECEDENTES-DE-USO.docx'
                                    }
                                ]}
                                title="Forma Digital"
                                type="word"
                        />
                    </Seccion>

                    <Seccion title="2. SUSTANCIA ACTIVA GRADO TÉCNICO/ SOPORTE GRADO TÉCNICO" id="sustancia-activa-grado-tecnico">
                        <SeccionDeDocumentos items={[
                            {
                                title: 'FOR-CTE-052 – Check List Experimental GT Nueva',
                                url: 'https://www.senave.gov.py/docs/agroquimicos/registros-agroquimicos/52_FOR-CTE-052%20Check%20List%20Experimental%20GT%20Nueva.docx'
                            }
                        ]} title="" type="punto" />
                        <SeccionDeDocumentos items={[
                            {
                                title: 'FOR-CTE-060 – ANEXO I RESUMEN. ESTUDIOS SOLICITADOS EN EL CUERPO III (Forma Física)',
                                url: 'https://www.senave.gov.py/docs/agroquimicos/registros-agroquimicos/60_FOR-CTE-060%20ANEXO%20I%20RESUMEN.%20ESTUDIOS%20SOLICITADOS%20EN%20EL%20CUERPO%20III.docx'
                            },
                        ]} title="Forma Digital" type="punto"/>
                    </Seccion>

                    <SeccionDeDocumentos
                            items={mockData.informaciones_generales}
                            title="Informaciones generales"
                            type="enlace"
                    />

                    <SeccionDeDocumentos
                            items={mockData.solicitudes_pos_registros}
                            title="Solicitudes pos registros"
                            type="enlace"
                    />
                </Seccion>

                <section class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm max-w-2xl">
                    <h3 class="text-gray-500 font-bold text-sm tracking-wider uppercase mb-5">
                        Correos Disponibles
                    </h3>

                    <div class="space-y-5 text-sm text-gray-600">
                        <div>
                            <p class="font-medium text-gray-700">Correo Institucional</p>
                            <a href="mailto:comite.tecnico@senave.gov.py" class="text-gray-500 hover:text-[#00A240] transition-colors">
                                comite.tecnico@senave.gov.py
                            </a>
                        </div>

                        <div>
                            <p class="font-medium text-gray-700">Para envío de solicitudes de Check List (Producto formulado y Grado Técnico) y visto bueno de solicitudes</p>
                            <a href="mailto:cte.dag2020@gmail.com" class="text-gray-500 hover:text-[#00A240] transition-colors">
                                cte.dag2020@gmail.com
                            </a>
                        </div>

                        <div>
                            <p class="font-medium text-gray-700">Para consultas, respuesta a notificaciones:</p>
                            <a href="mailto:ctedag2021@gmail.com" class="text-[#00A240] font-medium hover:underline">
                                ctedag2021@gmail.com
                            </a>
                        </div>
                    </div>
                </section>

                <Seccion title="Fertilizantes, inoculantes, biofertilizantes, enmiendas" id="fertilizantes-inoculantes-biofertilizantes-enmiendas">
                    <SeccionDeDocumentos items={[
                        {title: "Requisitos. Registro de fertilizantes, biofertilizantes, inoculantes, enmiendas", url: '#'},
                        {title: "Requisitos. Registro de materia prima de fertilizantes", url: '#'},
                        {title: "Renovación de registros de fertilizantes y materia prima", url: '#'},
                        {title: "Información. Proyecto de etiqueta", url: '#'},
                        {title: "Tutorial para solicitud de registro de fertilizantes en el TES ", url: '#'},

                    ]} title="" type="word" />

                    <SeccionDeDocumentos items={[
                        {title: 'Modificación de componentes en la formulación-productos fertilizantes ', url: '#'},
                        {title: 'Cambio de nombre de fertilizantes ', url: '#'},
                        {title: 'Cambio de razón social del fabricante/ formulador ', url: '#'},
                        {title: 'Cambio de categoría de productos fertilizantes, inoculantes, afines ', url: '#'},
                        {title: 'Cambio de datos en registros de productos fitosanitarios y fertilizantes  ', url: '#'},
                        {title: 'Transferencias de registros de productos fertilizantes, inoculantes, afines ', url: '#'},
                        {title: 'Cancelación de registro  ', url: '#'},

                    ]} title="" type="word"/>
                </Seccion>

                <section class="max-w-7xl mx-auto px-4 py-8 mb-11">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                        <div class="flex flex-col space-y-4">
                            <h3 class="text-[#005c26] font-bold text-lg md:text-xl text-center leading-snug">
                                Renovación de registro de fertilizantes y materia prima (Sin modificaciones del registro)
                            </h3>
                            <div class="overflow-hidden rounded-lg shadow-md bg-black aspect-video w-full">
                                <video
                                        controls
                                        class="w-full h-full object-cover"
                                >
                                    <source src="https://www.senave.gov.py/videos/Renovacion%20De%20Registro%20Sin%20Modificadores.mp4" type="video/mp4">
                                    Tu navegador no soporta la reproducción de videos.
                                </video>
                            </div>
                        </div>

                        <div class="flex flex-col space-y-4">
                            <h3 class="text-[#005c26] font-bold text-lg md:text-xl text-center leading-snug">
                                Renovación de registro de fertilizantes y materia prima (Con modificaciones de registros)
                            </h3>
                            <div class="overflow-hidden rounded-lg shadow-md bg-black aspect-video w-full">
                                <video
                                        controls
                                        class="w-full h-full object-cover"
                                >
                                    <source src="https://www.senave.gov.py/videos/Renovacion%20De%20Registro%20Vencido.mp4" type="video/mp4">
                                    Tu navegador no soporta la reproducción de videos.
                                </video>
                            </div>
                        </div>



                    </div>
                    <SeccionDeDocumentos items={[
                        {subtitle: 'Nota proforma', title: 'Solicitud de renovación de productos fertilizantes, bio fertilizantes, inoculantes, enmiendas, afines y materia prima ', url: '#'},
                        {subtitle: 'Nota proforma. ', title: 'Actualización de datos de inoculantes ', url: '#'},
                        {subtitle: 'Nota proforma. ', title: 'Solicitud de registro de productos fertilizantes, bio fertilizantes, inoculantes, enmiendas, afines y materia prima ', url: '#'},
                        {subtitle: 'Nota proforma. ', title: 'Formulario de pago de tasas de registro de productos fertilizantes, bio fertilizantes, inoculantes, enmiendas, afines y materia prima ', url: '#'},

                    ]} title="Formularios: " type="word"/>
                </section>

                <Seccion title="Muestra" id="muestra">
                    <SeccionDeDocumentos items={[
                        {title: 'REQUISITOS. REGISTRO DE MUESTRA DE PRODUCTOS FITOSANITARIOS Y DE FERTILIZANTES, BIOFERTILIZANTES, INOCULANTES, ENMIENDAS ', url: '#'}
                    ]} title="Registro de muestra de productos fitosanitarios y fertilizantes, biofertilizantes, inoculantes, enmiendas" type="ppt"/>

                    <SeccionDeDocumentos items={[
                        {title: 'Solicitud para importación/exportación de muestras de productos fitosanitarios fertilizantes, biofertilizante enmiendas ', url:'#'}
                    ]} title="Formulario: " type="word"/>
                </Seccion>

                <Seccion title="Extensión de nombre comercial" id="extension-de-nombre-comercial">
                    <SeccionDeDocumentos items={[
                        {subtitle:'Requisitos. ', title: 'Trámite de extensión de nombre comercial  ', url: '#'}
                    ]} title="" type="ppt"/>

                    <SeccionDeDocumentos items={[
                        {title: 'Autorización para extensión de nombre comercial ', url:'#'}
                    ]} title="Formulario: " type="word"/>
                </Seccion>

                <Seccion title="Importaciones exportaciones" id="importaciones-exportaciones">
                    <div class="space-y-8">

                        <div class="space-y-3">
                            <h4 class="text-base font-bold text-gray-800">Autorización sin intervención-SENAVE</h4>
                            <p class="text-gray-600">
                                La solicitud debe realizarse en la Ventanilla Única del Importador (VUI) <span class="font-bold text-gray-700 block mt-1">Requisitos para el trámite</span>
                            </p>
                            <div class="w-full max-w-3xl rounded-xl bg-white border border-gray-100 divide-y divide-gray-50 overflow-hidden">
                                <div class="flex items-start gap-3 px-5 py-3.5 hover:bg-[#E8F8EE]/40 transition-colors group">
                                    <svg class="w-5 h-5 shrink-0 mt-0.5 text-[#00A240]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                    </svg>
                                    <a href="#" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-700 hover:underline font-medium leading-snug flex-1 group-hover:text-[#00560E]">
                                        Nota proforma. Solicitud sin intervención
                                    </a>
                                </div>
                                <div class="flex items-start gap-3 px-5 py-3.5 text-sm text-gray-600 font-medium bg-gray-50/30">
                                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mt-2 shrink-0"></span>
                                    <span>Factura Comercial</span>
                                </div>
                                <div class="flex items-start gap-3 px-5 py-3.5 text-sm text-gray-600 font-medium bg-gray-50/30">
                                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mt-2 shrink-0"></span>
                                    <span>Hoja de seguridad del producto</span>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-3">
                            <h4 class="text-base font-bold text-gray-800">Autorización previa a la importación- APIM</h4>
                            <p class="text-gray-600">
                                La solicitud debe realizarse en la Ventanilla Única del Importador (VUI) <span class="font-bold text-gray-700 block mt-1">Requisitos</span>
                            </p>
                            <div class="w-full max-w-3xl rounded-xl bg-white border border-gray-100 divide-y divide-gray-50 overflow-hidden">
                                <div class="flex items-start gap-3 px-5 py-3.5 text-sm text-gray-600 font-medium bg-gray-50/30">
                                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mt-2 shrink-0"></span>
                                    <span>Factura Comercial</span>
                                </div>
                                <div class="flex items-start gap-3 px-5 py-3.5 text-sm text-gray-600 font-medium bg-gray-50/30">
                                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mt-2 shrink-0"></span>
                                    <span>Autorización de importación para terceros (en el caso que el registro no sea del importador).</span>
                                </div>
                                <div class="flex items-start gap-3 px-5 py-3.5 hover:bg-[#E8F8EE]/40 transition-colors group">
                                    <svg class="w-5 h-5 shrink-0 mt-0.5 text-[#00A240]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                    </svg>
                                    <a href="#" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-700 hover:underline font-medium leading-snug flex-1 group-hover:text-[#00560E]">
                                        Ejemplo de desglose del cálculo del valor CIF a valor FOB
                                    </a>
                                </div>
                            </div>
                            <p class="text-sm text-gray-600 pt-1">
                                <span class="font-bold text-gray-700">Plazo de emisión:</span> 5 días hábiles
                            </p>
                        </div>

                        <div class="space-y-3">
                            <h4 class="text-base font-bold text-gray-800">Certificado de exportación de insumos agrícolas- CEIA</h4>
                            <p class="text-gray-600">
                                La solicitud debe realizarse en la Ventanilla Única del Exportador (VUE) <span class="font-bold text-gray-700 block mt-1">Requisitos</span>
                            </p>
                            <div class="w-full max-w-3xl rounded-xl bg-white border border-gray-100 divide-y divide-gray-50 overflow-hidden">
                                <div class="flex items-start gap-3 px-5 py-3.5 text-sm text-gray-600 font-medium bg-gray-50/30">
                                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mt-2 shrink-0"></span>
                                    <span>Factura Comercial</span>
                                </div>
                                <div class="flex items-start gap-3 px-5 py-3.5 text-sm text-gray-600 font-medium bg-gray-50/30">
                                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mt-2 shrink-0"></span>
