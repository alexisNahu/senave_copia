---
import MecipLayout from "../../layouts/MecipLayout.astro";

const pdfUrl = "https://www.senave.gov.py/mecip/Documentos/Informe%20de%20Evaluacion%20del%20SCI-SENAVE-2025%20(1).pdf";
---

<MecipLayout>
    <main class="max-w-4xl mx-auto px-6 py-10">

        <div class="border-b-2 border-slate-200 pb-4 mb-8">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-800 tracking-wide uppercase">
                Informes
            </h1>
        </div>

        <div class="bg-white/80 backdrop-blur-xs p-6 rounded-xl shadow-xs border border-slate-100 transition-all hover:shadow-md">
            <ul class="space-y-3">
                <li>
                    <a
                            href={pdfUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group flex items-center gap-3 text-blue-600 hover:text-blue-800 font-medium transition-colors duration-150 text-[15px]"
                    >
                        <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4 text-amber-500 shrink-0 transition-transform group-hover:translate-x-0.5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="3"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>

                        <i class="bi bi-file-earmark-pdf-fill text-red-600 text-lg shrink-0"></i>

                        <span class="underline decoration-blue-300 group-hover:decoration-blue-600 transition-colors break-all">
              Informe de Evaluación del SCI-SENAVE-2025 (1).pdf
            </span>
                    </a>
                </li>
            </ul>
        </div>

    </main>
</MecipLayout>
