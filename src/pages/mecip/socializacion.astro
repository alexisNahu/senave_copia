---

<MecipLayout>
    <main class="max-w-4xl mx-auto px-6 py-10">
        <div class="border-b-2 border-slate-200 pb-4 mb-8">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-800 tracking-wide uppercase">
                Implementación de la NRM / MECIP 2015
            </h1>
        </div>

        <div class="space-y-6">
            {seccionesMecip.map((seccion) => (
                    <details class="group bg-white/80 rounded-xl shadow-sm border border-slate-100 transition-all hover:shadow-md" open>
                        <summary class="flex items-center justify-between cursor-pointer list-none p-5 rounded-xl">
                            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                                <span class="w-2 h-5 bg-verde rounded-xs inline-block"></span>
                                {seccion.titulo}
                            </h2>
                            <svg
                                    class="w-5 h-5 text-gray-500 transition-transform duration-300 group-open:rotate-180"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                            >
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </summary>

                        <div class="px-5 pb-5 pt-2 border-t border-slate-100">
                            <div class="space-y-4">
                                {seccion.subsecciones.map((subseccion) => (
                                        <details class="group/sub">
                                            <summary class="text-md font-semibold text-gray-700 mb-2 flex items-center gap-2 cursor-pointer list-none">
                                                <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        class="w-4 h-4 text-green-600 flex-shrink-0 transition-transform duration-300 group-open/sub:rotate-90"
                                                        fill="none"
                                                        viewBox="0 0 24 24"
                                                        stroke="currentColor"
                                                        stroke-width="2.5"
                                                >
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                                                </svg>
                                                {subseccion.titulo}
                                                <span class="text-xs text-gray-400 ml-2">
                                            ({subseccion.documentos.length} {subseccion.documentos.length === 1 ? 'documento' : 'documentos'})
                                        </span>
                                            </summary>
                                            <div class="pl-6 mt-2">
                                                {subseccion.documentos && subseccion.documentos.length > 0 && (
                                                        <SeccionDeDocumentos
                                                                items={subseccion.documentos}
                                                                title=""
                                                                type="pdf"
                                                        />
                                                )}
                                            </div>
                                        </details>
                                ))}
                            </div>
                        </div>
                    </details>
            ))}
        </div>
    </main>
</MecipLayout>
