---
import Layout from '../layouts/Layout.astro';
import Header from '../features/servicios/Header.astro';
import SidebarNav from '../components/SidebarNav.astro';
import Seccion from "../components/Seccion.astro";
import SeccionDeDocumentos from "../components/SeccionDeDocumentos.astro";
import PrincipalImage from "../components/PrincipalImage.astro";

// Items de navegación
const navItems = [
    { href: '#informes-gestion', label: 'Informes de Gestión' },
    { href: '#anuarios-estadisticos', label: 'Anuarios estadísticos' },
    { href: '#registros-importacion-exportacion', label: 'Registros de Importación y Exportación' },
    { href: '#boletines-informacion', label: 'Boletines de información' },
    { href: '#mapas', label: 'Mapas' }
];

// ========== INFORMES DE GESTIÓN ==========
const informesGestion = [
    { title: "Informe de Gestión 2025", url: "https://www.senave.gov.py/docs/publicaciones/informes/IG_2025_VAC_ID2026_09.pdf", img: "https://www.senave.gov.py/img/informe-2025.png" },
    { title: "Informe de Gestión 2024", url: "https://www.senave.gov.py/docs/publicaciones/informes/IG_2024_ok.pdf", img: "https://www.senave.gov.py/img/informe-2024.png" },
    { title: "Informe de Gestión 2018-2023", url: "https://www.senave.gov.py/docs/publicaciones/informes/Informe_03.pdf", img: "https://www.senave.gov.py/img/informe-gestion2023-02.jpg" },
    { title: "Informe de Gestión 2018-2023 (2)", url: "https://www.senave.gov.py/docs/publicaciones/informes/INFORME%20DE%20GESTION%202018-2023.pdf", img: "https://www.senave.gov.py/img/informe-gestion2023.jpg" },
    { title: "Informe de Gestión 2022", url: "https://www.senave.gov.py/docs/publicaciones/informes/MAQUETA%202022%2005.pdf", img: "https://www.senave.gov.py/img/informe-gestion2022.jpg" },
    { title: "Informe de Gestión 2021", url: "https://www.senave.gov.py/docs/publicaciones/ley5189/Informe%20de%20Gestion%202021%2005.pdf", img: "https://www.senave.gov.py/img/informe-gestion-2021.jpg" },
    { title: "Informe de Gestión (3 años)", url: "https://www.senave.gov.py/docs/publicaciones/ley5189/Informe%20de%20Gestion%202021.pdf", img: "https://www.senave.gov.py/img/informe-gestion2021.jpg" },
    { title: "Informe de Gestión 2020", url: "https://www.senave.gov.py/docs/publicaciones/ley5189/Informe%20de%20Gestion%20SENAVE%202020%20MOD%2001.pdf", img: "https://www.senave.gov.py/img/informe-gestion2020.jpg" },
    { title: "Informe de Gestión 2019", url: "https://www.senave.gov.py/docs/publicaciones/ley5189/IG%20SENAVE%202020%20FINAL.pdf", img: "https://www.senave.gov.py/img/inform-gestion2019.jpg" },
    { title: "Informe de Gestión 2018", url: "https://www.senave.gov.py/docs/publicaciones/ley5189/INFORME%20DE%20GESTION%20SENAVE%202018.pdf", img: "https://www.senave.gov.py/img/inform-gestion2018.jpg" },
    { title: "Informe de Gestión 2017", url: "https://www.senave.gov.py/docs/publicaciones/ley5189/Informe%20de%20Gestion%202017%2019%20%20Marzo.pdf", img: "https://www.senave.gov.py/img/inform-gestion2017.jpg" },
    { title: "Informe de Gestión 2016", url: "https://www.senave.gov.py/docs/publicaciones/ley5189/INFORME%20DE%20GESTION%20SENAVE%202017%20MS.pdf", img: "https://www.senave.gov.py/img/inform-gestion2016.jpg" },
    { title: "Informe de Gestión 2015", url: "https://www.senave.gov.py/docs/publicaciones/ley5189/INFORME-GESTION-2015-A.pdf", img: "https://www.senave.gov.py/img/inform-gestion2015.jpg" },
    { title: "Informe de Gestión 2014", url: "https://www.senave.gov.py/docs/publicaciones/informes/Informe%20de%20Gestion%202014.pdf", img: "https://www.senave.gov.py/img/inform-gestion2014.jpg" },
    { title: "Informe de Gestión 2013", url: "https://www.senave.gov.py/docs/publicaciones/informes/Informe%20de%20Gestion%202013_SENAVE.pdf", img: "https://www.senave.gov.py/img/anuario-2013.jpg" },
    { title: "Informe de Gestión 2012", url: "https://www.senave.gov.py/docs/publicaciones/ley5189/informe%20Gestion%202012%20ok.pdf", img: "https://www.senave.gov.py/img/informe-de-gestion-2012.jpg" },
    { title: "Informe de Gestión 2009", url: "https://www.senave.gov.py/docs/publicaciones/informes/gestion2009.pdf", img: "https://www.senave.gov.py/img/informe-2009.jpg" },
    { title: "Informe de Gestión 2008", url: "https://www.senave.gov.py/docs/publicaciones/informes/gestion2008.pdf", img: "https://www.senave.gov.py/img/informe-2008.jpg" },
    { title: "Informe de Gestión 2007", url: "https://www.senave.gov.py/docs/publicaciones/informes/gestion2007.pdf", img: "https://www.senave.gov.py/img/informe-2007.jpg" },
    { title: "Informe de Gestión 2006", url: "https://www.senave.gov.py/docs/publicaciones/informes/gestion2006.pdf", img: "https://www.senave.gov.py/img/informe-2006.jpg" }
];

// ========== ANUARIOS ESTADÍSTICOS ==========
const anuariosEstadisticos = [
    { title: "Anuario Estadístico 2020", url: "https://www.senave.gov.py/docs/publicaciones/informes/ANUARIO%20Estadistico%202020%20sin%20ISBN.pdf", img: "https://www.senave.gov.py/img/anuario-senave-2020.jpg" },
    { title: "Anuario Estadístico 2019", url: "https://www.senave.gov.py/docs/publicaciones/informes/Anuario%20Estadistico%202019%20vector.pdf", img: "https://www.senave.gov.py/img/anuario-senave-2019.jpg" },
    { title: "Anuario Estadístico 2018", url: "https://www.senave.gov.py/docs/publicaciones/informes/SENAVE%20ANUARIO%20ESTADISTICO%20SENAVE%202018.pdf", img: "https://www.senave.gov.py/img/anuario-senave-2018.jpg" },
    { title: "Anuario Estadístico 2017", url: "https://www.senave.gov.py/docs/publicaciones/informes/ANUARIO%20ESTADISTICO%20SENAVE%202018.pdf", img: "https://www.senave.gov.py/img/anuario-senave-2017.jpg" },
    { title: "Anuario Estadístico 2016", url: "https://www.senave.gov.py/docs/publicaciones/informes/ANUARIO%20ESTADISTICO%20SENAVE%202016%20FINAL.pdf", img: "https://www.senave.gov.py/img/anuario-senave-2016.jpg" },
    { title: "Anuario Estadístico 2015", url: "https://www.senave.gov.py/docs/publicaciones/informes/ANUARIO%202015.pdf", img: "https://www.senave.gov.py/img/anuario-senave-2015.jpg" },
    { title: "Anuario Estadístico 2014", url: "https://www.senave.gov.py/docs/publicaciones/informes/Anuario%20Estadistico%202014.pdf", img: "https://www.senave.gov.py/img/anuario-Estadistico2014.jpg" },
    { title: "Anuario Estadístico 2013", url: "https://www.senave.gov.py/docs/publicaciones/informes/Anuario%20Estadistico%202013_SENAVE.pdf", img: "https://www.senave.gov.py/img/anuario-Estadistico2013.jpg" },
    { title: "Anuario Estadístico 2012", url: "https://www.senave.gov.py/docs/publicaciones/informes/senave%20anuario%202012.pdf", img: "https://www.senave.gov.py/img/anuario-senave-2012.jpg" },
    { title: "Anuario Estadístico 2011", url: "https://www.senave.gov.py/docs/publicaciones/informes/Anuario%20Estadistico%202011.pdf", img: "https://www.senave.gov.py/img/Anuario2011.jpg" },
    { title: "Anuario Estadístico 2009", url: "https://www.senave.gov.py/docs/publicaciones/anuarios/anuario2009.pdf", img: "https://www.senave.gov.py/img/anuario-2009.jpg" },
    { title: "Anuario Estadístico 2008", url: "https://www.senave.gov.py/docs/publicaciones/anuarios/Anuario2008.pdf", img: "https://www.senave.gov.py/img/anuario-2008.jpg" },
    { title: "Anuario Estadístico 2007", url: "https://www.senave.gov.py/docs/publicaciones/anuarios/anuario2007.pdf", img: "https://www.senave.gov.py/img/anuario-2007.jpg" }
];

// ========== REGISTROS DE IMPORTACIÓN ==========
const registrosImportacion = [
    { title: "Productos Frutihortícolas 2024", url: "https://www.senave.gov.py/docs/geoestadisticas/Productos%20frutihorticolas%202024.pdf" },
    { title: "Frutos Frescos 2024", url: "https://www.senave.gov.py/docs/geoestadisticas/Frutos%20Frescos%202024.pdf" },
    { title: "Productos Frutihortícolas 2023", url: "https://www.senave.gov.py/wp-content/uploads/2025/01/Productos-Frutihorticolas-2023.pdf" },
    { title: "Frutos Frescos 2023", url: "https://www.senave.gov.py/wp-content/uploads/2025/01/FRUTOS-FRESCOS-2023.pdf" },
    { title: "Importación Fertilizantes 2024", url: "https://www.senave.gov.py/docs/geoestadisticas/Productos%20fitosanitarios%20y%20fertilizantes%202024.pdf" },
    { title: "Importación Fertilizantes 2023", url: "https://www.senave.gov.py/wp-content/uploads/2025/01/Importacion-FERTILIZANTES-2023.pdf" },
    { title: "Importación Productos Fitosanitarios", url: "https://www.senave.gov.py/wp-content/uploads/2025/01/IMPORTACION-Productos-fitosanitarios.pdf" }
];

// ========== REGISTROS DE EXPORTACIÓN ==========
const registrosExportacion = [
    { title: "Exportación Oleaginosas 2023", url: "https://www.senave.gov.py/wp-content/uploads/2025/01/EXPORTACION-OLEAGINOSAS-2023.pdf" },
    { title: "Exportación Frutihortícola 2023", url: "https://www.senave.gov.py/wp-content/uploads/2025/01/EXPORTACION-FRUTIHORTICOLA-2023.pdf" },
    { title: "Exportaciones de Chía y Sésamo (10 años)", url: "https://www.senave.gov.py/wp-content/uploads/2025/01/EXPORTACIONES-CHIA-Y-SESAMO-10-AÑOS.pdf" },
    { title: "Exportación de Productos Frutihortícolas 2024", url: "https://www.senave.gov.py/docs/geoestadisticas/Prensa-Frutihorticola2024-export.pdf" },
    { title: "Productos fitosanitarios 2024", url: "https://www.senave.gov.py/docs/geoestadisticas/EXPORTACION%20productos%20fitosanitarios%202024.pdf" }
];

// ========== BOLETINES DE INFORMACIÓN ==========
const boletinesInformacion = [
    { title: "Boletín Diciembre 2024", url: "https://www.senave.gov.py/wp-content/uploads/2025/01/Boletin-Diciembre-2024.pdf" },
    { title: "Boletín Noviembre 2024", url: "https://www.senave.gov.py/wp-content/uploads/2025/01/Boletin-Noviembre-2024.pdf" },
    { title: "Boletín Octubre 2024", url: "https://www.senave.gov.py/wp-content/uploads/2025/01/Boletin-Octubre-2024.pdf" },
    { title: "Boletín Septiembre 2024", url: "https://www.senave.gov.py/wp-content/uploads/2025/01/Boletín-septiembre-2024.pdf" }
];
---

<Layout>
    <Header title="Geoestadísticas" />

    <PrincipalImage
            src="https://www.senave.gov.py/wp-content/uploads/2025/01/foto-SENAVE-2.jpg"
            alt="Geoestadísticas SENAVE"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col lg:flex-row gap-10">

            <SidebarNav navItems={navItems} />

            <main class="flex-1 text-sm text-gray-700 space-y-12 leading-relaxed">

                <!-- Informes de Gestión -->
                <Seccion title="Informes de Gestión" id="informes-gestion">
                    <div class="flex flex-wrap gap-4">
                        {informesGestion.map((item) => (
                                <a href={item.url} target="_blank" rel="noopener" class="inline-block transition hover:opacity-80">
                                    <img src={item.img} alt={item.title} class="w-[120px] h-[162px] object-cover border border-gray-200 rounded shadow-sm" loading="lazy" />
                                </a>
                        ))}
                    </div>
                </Seccion>

                <!-- Anuarios estadísticos -->
                <Seccion title="Anuarios estadísticos" id="anuarios-estadisticos">
                    <div class="flex flex-wrap gap-4">
                        {anuariosEstadisticos.map((item) => (
                                <a href={item.url} target="_blank" rel="noopener" class="inline-block transition hover:opacity-80">
                                    <img src={item.img} alt={item.title} class="w-[120px] h-[162px] object-cover border border-gray-200 rounded shadow-sm" loading="lazy" />
                                </a>
                        ))}
                    </div>
                </Seccion>

                <!-- Registros de Importación y Exportación -->
                <Seccion title="Registros de Importación y Exportación" id="registros-importacion-exportacion">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <!-- Columna Importación -->
                        <div>
                            <h3 class="text-green-700 font-bold text-base mb-4">IMPORTACIÓN</h3>
                            <p class="font-medium text-gray-800 mb-2">Productos Vegetales</p>
                            <SeccionDeDocumentos items={registrosImportacion.slice(0, 4)} title="" type="pdf" />
                            <p class="font-medium text-gray-800 mt-4 mb-2">Productos Fitosanitarios y Fertilizantes</p>
                            <SeccionDeDocumentos items={registrosImportacion.slice(4)} title="" type="pdf" />
                        </div>

                        {/* Columna Exportación */}
                        <div>
                            <h3 class="text-green-700 font-bold text-base mb-4">EXPORTACIÓN</h3>
                            <p class="font-medium text-gray-800 mb-2">Productos Vegetales</p>
                            <SeccionDeDocumentos items={registrosExportacion.slice(0, 4)} title="" type="pdf" />
                            <p class="font-medium text-gray-800 mt-4 mb-2">Productos Fitosanitarios y Fertilizantes</p>
                            <SeccionDeDocumentos items={registrosExportacion.slice(4)} title="" type="pdf" />
                        </div>
                    </div>
                </Seccion>

                <!-- Boletines de información -->
                <Seccion title="Boletines de información" id="boletines-informacion">
                    <p class="text-gray-700 mb-4">
                        Estos boletines presentan información detallada sobre los precios de los productos frutihortícolas más importantes. Se incluye un análisis de los productos de mayor relevancia en el ámbito vegetal, proporcionando datos actualizados y confiables.
                    </p>
                    <SeccionDeDocumentos items={boletinesInformacion} title="" type="pdf" />

                    <h3 class="text-green-700 font-bold text-lg mt-8 mb-4">Boletín Estadístico Bimestral</h3>
                    <div class="space-y-2">
                        <a href="https://www.senave.gov.py/geoestadisticas/boletin-estadistico-bimestral-2026" target="_blank" class="flex items-center gap-3 text-gray-700 hover:text-green-600 transition">
                            <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 512 512">
                                <path d="M80 368H16a16 16 0 0 0-16 16v64a16 16 0 0 0 16 16h64a16 16 0 0 0 16-16v-64a16 16 0 0 0-16-16zm0-320H16A16 16 0 0 0 0 64v64a16 16 0 0 0 16 16h64a16 16 0 0 0 16-16V64a16 16 0 0 0-16-16zm0 160H16a16 16 0 0 0-16 16v64a16 16 0 0 0 16 16h64a16 16 0 0 0 16-16v-64a16 16 0 0 0-16-16zm416 176H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16zm0-320H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16V80a16 16 0 0 0-16-16zm0 160H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16z"/>
                            </svg>
                            <span>Boletín Estadístico Bimestral 2026</span>
                        </a>
                        <a href="https://www.senave.gov.py/geoestadisticas/boletin-estadistico-bimestral-2025" target="_blank" class="flex items-center gap-3 text-gray-700 hover:text-green-600 transition">
                            <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 512 512">
                                <path d="M80 368H16a16 16 0 0 0-16 16v64a16 16 0 0 0 16 16h64a16 16 0 0 0 16-16v-64a16 16 0 0 0-16-16zm0-320H16A16 16 0 0 0 0 64v64a16 16 0 0 0 16 16h64a16 16 0 0 0 16-16V64a16 16 0 0 0-16-16zm0 160H16a16 16 0 0 0-16 16v64a16 16 0 0 0 16 16h64a16 16 0 0 0 16-16v-64a16 16 0 0 0-16-16zm416 176H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16zm0-320H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16V80a16 16 0 0 0-16-16zm0 160H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16z"/>
                            </svg>
                            <span>Boletín Estadístico Bimestral 2025</span>
                        </a>
                    </div>
                </Seccion>

                <!-- Mapas -->
                <Seccion title="Mapas" id="mapas">
                    <div class="rounded-lg overflow-hidden shadow-md border border-gray-200">
                        <iframe
                                src="https://senave.maps.arcgis.com/apps/dashboards/9aec9c5abbd24c6ca240cdad5cfd9f1e"
                                width="100%"
                                height="650"
                                frameborder="0"
                                allowfullscreen
                                class="w-full"
                        ></iframe>
                    </div>
                </Seccion>

            </main>
        </div>
    </div>
</Layout>
